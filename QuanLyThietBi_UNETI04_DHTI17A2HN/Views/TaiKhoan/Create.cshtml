@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.TaiKhoan
@{
    ViewData["Title"] = "Thêm tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0f172a;">
            <i class="bi bi-person-plus-fill text-primary me-2"></i>Thêm tài khoản người dùng
        </h3>
        <p class="text-muted small mb-0">Cấp tài khoản đăng nhập và phân quyền hệ thống</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

            <div class="card-enterprise mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <span class="fw-bold" style="color: #0f172a;">
                        <i class="bi bi-person-badge text-primary me-2"></i>Thông tin tài khoản & Vai trò
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TenDangNhap" class="form-label fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                            <input asp-for="TenDangNhap" class="form-control" placeholder="VD: user01, ktv_nam..." />
                            <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MatKhau" class="form-label fw-semibold">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                            <input asp-for="MatKhau" class="form-control" type="password" placeholder="Nhập mật khẩu..." />
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HoTen" class="form-label fw-semibold">Họ và tên hiển thị <span class="text-danger">*</span></label>
                            <input asp-for="HoTen" class="form-control" placeholder="Họ và tên người dùng..." />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="VD: user@uneti.edu.vn" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="VaiTro" class="form-label fw-semibold">Vai trò phân quyền <span class="text-danger">*</span></label>
                            <select asp-for="VaiTro" class="form-select">
                                <option value="">-- Chọn vai trò phân quyền --</option>
                                <option value="Admin">Admin (Quản trị viên toàn quyền)</option>
                                <option value="KyThuatVien">Kỹ thuật viên (Sửa chữa & Kiểm định)</option>
                                <option value="KhachHang">Khách hàng (Tạo phiếu & Theo dõi)</option>
                            </select>
                            <span asp-validation-for="VaiTro" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TrangThai" class="form-label fw-semibold">Trạng thái kích hoạt</label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="Hoạt động">Hoạt động (Được đăng nhập)</option>
                                <option value="Bị khóa">Bị khóa (Chặn đăng nhập)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light px-4 py-3 d-flex justify-content-end gap-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i> Tạo tài khoản
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
