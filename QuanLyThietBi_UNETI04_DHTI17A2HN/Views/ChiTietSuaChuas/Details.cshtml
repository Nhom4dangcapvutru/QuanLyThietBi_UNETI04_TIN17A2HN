@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.ChiTietSuaChua

@{
    ViewData["Title"] = "Chi tiết sửa chữa #" + Model.MaChiTiet;
}


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --bg-main: #f8fafc;
        --card-bg: #ffffff;
        --border-color: #e2e8f0;
    }

    body {
        background-color: var(--bg-main);
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #334155;
    }

    .detail-header {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
        border-radius: 20px;
        padding: 2rem 2.5rem;
        color: #ffffff;
        box-shadow: 0 15px 30px -10px rgba(67, 56, 202, 0.3);
    }


    .info-card {
        background: var(--card-bg);
        border-radius: 20px;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .info-card-header {
        background: #f8fafc;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        font-weight: 700;
        color: #0f172a;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .info-item {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
    }

    .info-value {
        font-size: 0.975rem;
        font-weight: 600;
        color: #1e293b;
    }

  
    .price-box {
        background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
        border: 1px solid #bbf7d0;
        border-radius: 16px;
        padding: 1.5rem;
    }

   
    .badge-ticket {
        background: #e0e7ff;
        color: #3730a3;
        font-weight: 700;
        padding: 0.4em 0.8em;
        border-radius: 8px;
    }


    .btn-custom-secondary {
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        color: #475569;
        font-weight: 600;
        border-radius: 12px;
        padding: 0.625rem 1.25rem;
        transition: all 0.2s ease;
    }

        .btn-custom-secondary:hover {
            background-color: #f1f5f9;
            color: #0f172a;
        }

    .btn-custom-warning {
        background-color: #f59e0b;
        color: #ffffff;
        font-weight: 600;
        border-radius: 12px;
        padding: 0.625rem 1.5rem;
        border: none;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.25);
        transition: all 0.2s ease;
    }

        .btn-custom-warning:hover {
            background-color: #d97706;
            color: #ffffff;
        }
</style>

<div class="container-fluid px-4 py-4" style="max-width: 1200px;">


    <div class="detail-header mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-inline-flex align-items-center bg-white bg-opacity-10 px-3 py-1 rounded-pill mb-2">
                <i class="fa-solid fa-file-invoice me-2 text-warning"></i>
                <span class="small fw-semibold text-white-80">Thông tin chi tiết</span>
            </div>
            <h2 class="fw-bold fs-2 text-white mb-1">Mã Chi Tiết: #@Model.MaChiTiet</h2>
            <p class="text-white-50 mb-0">Phiếu sửa chữa tham chiếu: <span class="badge badge-ticket">#@Model.MaPhieu</span></p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-custom-secondary d-inline-flex align-items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Quay lại</span>
            </a>
            <a asp-action="Edit" asp-route-id="@Model.MaChiTiet" class="btn btn-custom-warning d-inline-flex align-items-center gap-2">
                <i class="fa-solid fa-pen-to-square"></i>
                <span>Chỉnh sửa</span>
            </a>
        </div>
    </div>

   
    <div class="row g-4">

       
        <div class="col-12 col-lg-7">
            <div class="info-card mb-4">
                <div class="info-card-header">
                    <i class="fa-solid fa-layer-group text-primary fs-5"></i>
                    <span>Thông Tin Nhân Sự & Linh Kiện</span>
                </div>
                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-12 col-sm-6 border-end-sm">
                            <div class="info-item">
                                <span class="info-label">Mã Chi Tiết Sửa Chữa</span>
                                <span class="info-value text-primary">#@Model.MaChiTiet</span>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="info-item">
                                <span class="info-label">Mã Phiếu Sửa Chữa</span>
                                <span class="info-value">
                                    <span class="badge badge-ticket">#@Model.MaPhieu</span>
                                </span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="info-item">
                                <span class="info-label">Kỹ Thuật Viên Phụ Trách</span>
                                <span class="info-value d-flex align-items-center gap-2 mt-1">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 32px; height: 32px; font-size: 13px;">
                                        <i class="fa-solid fa-user-gear"></i>
                                    </div>
                                    <span>@(Model.KyThuatVien?.HoTen ?? "Chưa phân công")</span>
                                </span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="info-item">
                                <span class="info-label">Linh Kiện / Vật Tư Thay Thế</span>
                                <span class="info-value text-dark fs-6 mt-1">
                                    <i class="fa-solid fa-microchip text-secondary me-2"></i>
                                    @(Model.LinhKien?.TenLinhKien ?? "Không xác định")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

         
            <div class="info-card">
                <div class="info-card-header">
                    <i class="fa-solid fa-clipboard-check text-info fs-5"></i>
                    <span>Kết Quả Chẩn Đoán & Ghi Chú</span>
                </div>
                <div class="card-body p-0">
                    <div class="info-item">
                        <span class="info-label">Kết Quả Chẩn Đoán</span>
                        <div class="info-value text-secondary mt-1 fw-normal">
                            @(string.IsNullOrEmpty(Model.KetQuaChanDoan) ? "Chưa có kết quả chẩn đoán." : Model.KetQuaChanDoan)
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Ghi Chú Mở Rộng</span>
                        <div class="info-value text-secondary mt-1 fw-normal">
                            @(string.IsNullOrEmpty(Model.GhiChu) ? "Không có ghi chú thêm." : Model.GhiChu)
                        </div>
                    </div>
                </div>
            </div>
        </div>

       
        <div class="col-12 col-lg-5">
            <div class="info-card">
                <div class="info-card-header">
                    <i class="fa-solid fa-calculator text-success fs-5"></i>
                    <span>Chi Chiết Chi Phí</span>
                </div>
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="text-muted fw-semibold">Số lượng xuất</span>
                        <span class="fw-bold fs-6 text-dark">@Model.SoLuong</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="text-muted fw-semibold">Đơn giá linh kiện</span>
                        <span class="font-monospace fw-semibold text-dark">@Model.DonGia.ToString("N0") VNĐ</span>
                    </div>

                 
                    <div class="price-box mt-4">
                        <div class="text-uppercase small fw-bold text-success mb-1">Tổng Thành Tiền</div>
                        <div class="fs-2 fw-bold text-success font-monospace">
                            @Model.ThanhTien.ToString("N0") <span class="fs-6 fw-semibold text-success">VNĐ</span>
                        </div>
                        <div class="small text-success text-opacity-75 mt-1">
                            <i class="fa-solid fa-circle-info me-1"></i> Thành tiền = Số lượng × Đơn giá
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>