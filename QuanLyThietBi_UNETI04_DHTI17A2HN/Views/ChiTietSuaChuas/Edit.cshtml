@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.ChiTietSuaChua

@{
    ViewData["Title"] = "Sửa chi tiết sửa chữa #" + Model.MaChiTiet;
}


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
        --bg-main: #f8fafc;
        --card-bg: #ffffff;
        --border-color: #e2e8f0;
    }

    body {
        background-color: var(--bg-main);
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #334155;
    }


    .edit-header {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%);
        border-radius: 20px;
        padding: 2rem 2.5rem;
        color: #ffffff;
        box-shadow: 0 15px 30px -10px rgba(67, 56, 202, 0.3);
    }


    .form-card {
        background: var(--card-bg);
        border-radius: 20px;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .form-card-header {
        background: #f8fafc;
        padding: 1.25rem 1.75rem;
        border-bottom: 1px solid var(--border-color);
        font-weight: 700;
        color: #0f172a;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

  
    .form-label {
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #475569;
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        padding: 0.75rem 1rem;
        font-size: 0.925rem;
        font-weight: 500;
        color: #1e293b;
        background-color: #ffffff;
        transition: all 0.2s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
            outline: none;
        }

    .input-group-text {
        border-radius: 12px 0 0 12px;
        border: 1px solid #cbd5e1;
        border-right: none;
        background-color: #f8fafc;
        color: #64748b;
    }

    .input-group .form-control, .input-group .form-select {
        border-radius: 0 12px 12px 0;
    }

    .notice-box {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 14px;
        padding: 1rem 1.25rem;
    }

    
    .badge-ticket {
        background: #e0e7ff;
        color: #3730a3;
        font-weight: 700;
        padding: 0.4em 0.8em;
        border-radius: 8px;
    }

    .btn-custom-secondary {
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        color: #475569;
        font-weight: 600;
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        transition: all 0.2s ease;
    }

        .btn-custom-secondary:hover {
            background-color: #f1f5f9;
            color: #0f172a;
        }

    .btn-custom-primary {
        background: var(--primary-gradient);
        color: #ffffff;
        font-weight: 600;
        border-radius: 12px;
        padding: 0.75rem 1.75rem;
        border: none;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
        transition: all 0.2s ease;
    }

        .btn-custom-primary:hover {
            opacity: 0.95;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.45);
        }
</style>

<div class="container-fluid px-4 py-4" style="max-width: 1000px;">


    <div class="edit-header mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-inline-flex align-items-center bg-white bg-opacity-10 px-3 py-1 rounded-pill mb-2">
                <i class="fa-solid fa-pen-to-square me-2 text-warning"></i>
                <span class="small fw-semibold text-white">Cập nhật thông tin</span>
            </div>
            <h2 class="fw-bold fs-2 text-white mb-1">Chỉnh Sửa Chi Tiết Sửa Chữa</h2>
            <p class="text-white-50 mb-0">Cập nhật thông số linh kiện, số lượng và thông tin chẩn đoán kỹ thuật</p>
        </div>
        <div>
            <span class="badge bg-white text-primary fs-6 px-3 py-2 rounded-pill fw-bold shadow-sm">
                Mã CT: #@Model.MaChiTiet
            </span>
        </div>
    </div>

   
    <div class="form-card mb-4">
        <div class="form-card-header">
            <i class="fa-solid fa-sliders text-primary fs-5"></i>
            <span>Nhập Thông Tin Chỉnh Sửa</span>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="MaChiTiet" />

                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 mb-4 p-3" role="alert"></div>

          
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="MaPhieu" class="form-label">Phiếu sửa chữa</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-receipt"></i></span>
                            <select asp-for="MaPhieu" asp-items="ViewBag.MaPhieu" class="form-select">
                                <option value="">-- Chọn phiếu sửa chữa --</option>
                            </select>
                        </div>
                        <span asp-validation-for="MaPhieu" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="MaKyThuatVien" class="form-label">Kỹ thuật viên phụ trách</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-user-gear"></i></span>
                            <select asp-for="MaKyThuatVien" asp-items="ViewBag.MaKyThuatVien" class="form-select">
                                <option value="">-- Chọn kỹ thuật viên --</option>
                            </select>
                        </div>
                        <span asp-validation-for="MaKyThuatVien" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

       
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-8">
                        <label asp-for="MaLinhKien" class="form-label">Linh kiện / Vật tư thay thế</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-microchip"></i></span>
                            <select asp-for="MaLinhKien" asp-items="ViewBag.MaLinhKien" class="form-select">
                                <option value="">-- Chọn linh kiện --</option>
                            </select>
                        </div>
                        <span asp-validation-for="MaLinhKien" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="SoLuong" class="form-label">Số lượng xuất</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-hashtag"></i></span>
                            <input asp-for="SoLuong" type="number" min="1" class="form-control" placeholder="Nhập số lượng..." />
                        </div>
                        <span asp-validation-for="SoLuong" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

             
                <div class="mb-3">
                    <label asp-for="KetQuaChanDoan" class="form-label">Kết quả chẩn đoán kỹ thuật</label>
                    <textarea asp-for="KetQuaChanDoan" class="form-control" rows="3" placeholder="Nhập chi tiết chẩn đoán lỗi, tình trạng ban đầu..."></textarea>
                    <span asp-validation-for="KetQuaChanDoan" class="text-danger small mt-1 d-block"></span>
                </div>

            
                <div class="mb-4">
                    <label asp-for="GhiChu" class="form-label">Ghi chú bổ sung</label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2" placeholder="Ghi chú thêm về quy trình, phụ phí nếu có..."></textarea>
                    <span asp-validation-for="GhiChu" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="notice-box mb-4 d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                    <div class="small text-secondary">
                        <strong class="text-primary">Tính toán tự động:</strong> Đơn giá và tổng thành tiền sẽ được hệ thống tính toán lại chính xác dựa trên đơn giá niêm yết của linh kiện và số lượng mới thay đổi.
                    </div>
                </div>

            
                <div class="d-flex justify-content-end align-items-center gap-3 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-custom-secondary d-inline-flex align-items-center gap-2">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Quay lại</span>
                    </a>
                    <button type="submit" class="btn btn-custom-primary d-inline-flex align-items-center gap-2">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Lưu thay đổi</span>
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}