@* 
    Họ và tên: Nguyễn Thị Thảo
    Mã sinh viên: 23103100092
    Nội dung thực hiện: View thêm mới khách hàng
*@
@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.KhachHang

@{
    ViewData["Title"] = "Thêm khách hàng";
}

<h2 class="mb-4">➕ Thêm khách hàng mới</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            @* Hiển thị lỗi tổng quát *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @* ==================== HỌ TÊN ==================== *@
            <div class="mb-3">
                <label asp-for="HoTen" class="form-label"></label>
                <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên khách hàng" />
                <span asp-validation-for="HoTen" class="text-danger"></span>
            </div>

            @* ==================== SỐ ĐIỆN THOẠI ==================== *@
            <div class="mb-3">
                <label asp-for="SoDienThoai" class="form-label"></label>
                <input asp-for="SoDienThoai" class="form-control" placeholder="VD: 0901234567" />
                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
            </div>

            @* ==================== EMAIL ==================== *@
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" placeholder="VD: khachhang@gmail.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            @* ==================== ĐỊA CHỈ ==================== *@
            <div class="mb-3">
                <label asp-for="DiaChi" class="form-label"></label>
                <textarea asp-for="DiaChi" class="form-control" rows="2" placeholder="Địa chỉ liên hệ"></textarea>
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>

            @* ==================== CCCD ==================== *@
            <div class="mb-3">
                <label asp-for="CCCD" class="form-label"></label>
                <input asp-for="CCCD" class="form-control" placeholder="9-12 chữ số" />
                <span asp-validation-for="CCCD" class="text-danger"></span>
            </div>

            @* ==================== LOẠI KHÁCH HÀNG ==================== *@
            <div class="mb-3">
                <label asp-for="LoaiKhachHang" class="form-label"></label>
                <select asp-for="LoaiKhachHang" class="form-select" id="loaiKhachHang">
                    <option value="Cá nhân">Cá nhân</option>
                    <option value="Doanh nghiệp">Doanh nghiệp</option>
                </select>
                <span asp-validation-for="LoaiKhachHang" class="text-danger"></span>
            </div>

            @* ==================== MÃ SỐ THUẾ (chỉ hiện khi chọn Doanh nghiệp) ==================== *@
            <div class="mb-3" id="khungMaSoThue" style="display:none;">
                <label asp-for="MaSoThue" class="form-label"></label>
                <input asp-for="MaSoThue" class="form-control" placeholder="Mã số thuế doanh nghiệp" />
                <span asp-validation-for="MaSoThue" class="text-danger"></span>
            </div>

            @* ==================== TRẠNG THÁI ==================== *@
            <div class="mb-3">
                <label asp-for="TrangThai" class="form-label"></label>
                <select asp-for="TrangThai" class="form-select">
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Ngừng hoạt động">Ngừng hoạt động</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>

            @* ==================== GHI CHÚ ==================== *@
            <div class="mb-3">
                <label asp-for="GhiChu" class="form-label"></label>
                <textarea asp-for="GhiChu" class="form-control" rows="2" placeholder="Ghi chú nội bộ (nếu có)"></textarea>
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>

            @* ==================== NÚT ==================== *@
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">💾 Lưu</button>
                <a asp-action="Index" class="btn btn-secondary">↩ Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Hiện/ẩn ô Mã số thuế dựa vào Loại khách hàng
        document.addEventListener("DOMContentLoaded", function () {
            var loaiSelect = document.getElementById("loaiKhachHang");
            var khungMaSoThue = document.getElementById("khungMaSoThue");

            function toggleMaSoThue() {
                if (loaiSelect.value === "Doanh nghiệp") {
                    khungMaSoThue.style.display = "block";
                } else {
                    khungMaSoThue.style.display = "none";
                }
            }

            loaiSelect.addEventListener("change", toggleMaSoThue);
            toggleMaSoThue(); // Gọi lần đầu khi load
        });
    </script>
}