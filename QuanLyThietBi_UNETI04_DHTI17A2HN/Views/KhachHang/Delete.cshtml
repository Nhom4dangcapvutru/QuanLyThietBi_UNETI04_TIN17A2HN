@* 
    Họ và tên: Nguyễn Thị Thảo
    Mã sinh viên: 23103100092
    Nội dung thực hiện: View xác nhận xóa khách hàng
    (Chặn xóa nếu KH có thiết bị hoặc phiếu sửa chữa)
*@
@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.KhachHang

@{
    ViewData["Title"] = "Xóa khách hàng";

    // Kiểm tra có thể xóa hay không
    bool coThietBi = Model.ThietBis != null && Model.ThietBis.Any();
    bool coPhieu = Model.PhieuSuaChuas != null && Model.PhieuSuaChuas.Any();
    bool coTheXoa = !coThietBi && !coPhieu;
}

<h2 class="mb-4 text-danger">🗑️ Xóa khách hàng</h2>

@* ==================== CẢNH BÁO CHUNG ==================== *@
<div class="alert alert-warning">
    <strong>⚠️ Cảnh báo:</strong> Bạn có chắc chắn muốn xóa khách hàng này không?
    Hành động này không thể hoàn tác.
</div>

@* ==================== CẢNH BÁO NGHIỆP VỤ ==================== *@
@if (!coTheXoa)
{
    <div class="alert alert-danger">
        <strong>❌ Không thể xóa!</strong>
        <ul class="mb-0 mt-2">
            @if (coThietBi)
            {
                <li>Khách hàng đang có <strong>@Model.ThietBis.Count thiết bị</strong> trong hệ thống.</li>
            }
            @if (coPhieu)
            {
                <li>Khách hàng đang có <strong>@Model.PhieuSuaChuas.Count phiếu sửa chữa</strong> trong hệ thống.</li>
            }
        </ul>
        <p class="mb-0 mt-2">Vui lòng xóa thiết bị và phiếu sửa chữa trước khi xóa khách hàng.</p>
    </div>
}

@* ==================== THÔNG TIN KHÁCH HÀNG ==================== *@
<div class="card mb-4">
    <div class="card-header bg-danger text-white">
        <strong>Thông tin khách hàng cần xóa</strong>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Mã khách hàng</dt>
            <dd class="col-sm-9">@Model.MaKhachHang</dd>

            <dt class="col-sm-3">Họ và tên</dt>
            <dd class="col-sm-9"><strong>@Model.HoTen</strong></dd>

            <dt class="col-sm-3">Số điện thoại</dt>
            <dd class="col-sm-9">@Model.SoDienThoai</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Địa chỉ</dt>
            <dd class="col-sm-9">@(Model.DiaChi ?? "Chưa cập nhật")</dd>

            <dt class="col-sm-3">Loại khách hàng</dt>
            <dd class="col-sm-9">@Model.LoaiKhachHang</dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">@Model.TrangThai</dd>

            <dt class="col-sm-3">Ngày tạo</dt>
            <dd class="col-sm-9">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Số thiết bị</dt>
            <dd class="col-sm-9">@(Model.ThietBis?.Count ?? 0)</dd>

            <dt class="col-sm-3">Số phiếu sửa chữa</dt>
            <dd class="col-sm-9">@(Model.PhieuSuaChuas?.Count ?? 0)</dd>
        </dl>
    </div>
</div>

@* ==================== FORM XÁC NHẬN XÓA ==================== *@
<form asp-action="Delete" method="post" class="mt-4">
    <input type="hidden" asp-for="MaKhachHang" />

    @if (coTheXoa)
    {
        <button type="submit" class="btn btn-danger">
            🗑️ Xác nhận xóa
        </button>
    }
    else
    {
        <button type="button" class="btn btn-danger" disabled>
            🗑️ Không thể xóa
        </button>
    }

    <a asp-action="Index" class="btn btn-secondary">↩ Quay lại danh sách</a>
    <a asp-action="Details" asp-route-id="@Model.MaKhachHang" class="btn btn-info">👁️ Xem chi tiết</a>
</form>