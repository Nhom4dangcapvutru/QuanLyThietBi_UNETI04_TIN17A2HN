@* 
    Họ và tên: Nguyễn Thị Thảo
    Mã sinh viên: 23103100092
    Nội dung thực hiện: View tạo phiếu sửa chữa
    (Khách hàng chọn thiết bị của mình + mô tả lỗi + mức độ ưu tiên)
*@
@model QuanLyThietBi_UNETI04_DHTI17A2HN.ViewModels.PhieuSuaChuaCreateViewModel

@{
    ViewData["Title"] = "Tạo phiếu sửa chữa";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0f172a;">
            <i class="bi bi-file-earmark-plus-fill text-primary me-2"></i>Tạo phiếu yêu cầu sửa chữa
        </h3>
        <p class="text-muted small mb-0">Đăng ký thông tin thiết bị gặp sự cố để kỹ thuật viên kiểm tra</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Danh sách phiếu
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.TenKhachHang))
{
    <div class="alert alert-info d-flex align-items-center mb-4">
        <i class="bi bi-person-check-fill me-2 fs-5"></i>
        <div>
            Khách hàng gửi yêu cầu: <strong>@Model.TenKhachHang</strong> (Mã KH: #@Model.MaKhachHang)
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="MaKhachHang" />
            <input type="hidden" asp-for="TenKhachHang" />

            <div class="card-enterprise mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <span class="fw-bold" style="color: #0f172a;">
                        <i class="bi bi-tools text-primary me-2"></i>Thông tin sự cố thiết bị
                    </span>
                </div>
                <div class="card-body p-4">
                    @* Chọn thiết bị *@
                    <div class="mb-3">
                        <label asp-for="MaThietBi" class="form-label fw-semibold">
                            Thiết bị cần bảo hành / sửa chữa <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MaThietBi" class="form-select" id="chonThietBi">
                            <option value="">-- Chọn thiết bị của bạn --</option>
                            @foreach (var item in Model.DanhSachThietBi)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="MaThietBi" class="text-danger small"></span>
                        <div class="form-text small text-muted">
                            <i class="bi bi-info-circle me-1"></i>Hệ thống tự động lọc danh sách thiết bị thuộc sở hữu của bạn.
                        </div>
                    </div>

                    @* Preview thiết bị *@
                    @if (Model.TenThietBiDuocChon != null)
                    {
                        <div class="p-3 mb-3 rounded-3" style="background-color: #f0fdf4; border: 1px solid #bbf7d0;">
                            <div class="fw-semibold text-success mb-1">
                                <i class="bi bi-check-circle me-1"></i>Thiết bị: @Model.TenThietBiDuocChon
                            </div>
                            @if (Model.HanBaoHanhThietBi.HasValue)
                            {
                                <div class="small text-muted">
                                    Hạn bảo hành: @Model.HanBaoHanhThietBi.Value.ToString("dd/MM/yyyy")
                                    @if (Model.ConBaoHanh)
                                    {
                                        <span class="badge bg-success ms-2">Còn bảo hành</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark ms-2">Hết bảo hành (tính phí)</span>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @* Mức độ ưu tiên *@
                    <div class="mb-3">
                        <label asp-for="MucDo" class="form-label fw-semibold">
                            Mức độ ưu tiên / tính khẩn cấp <span class="text-danger">*</span>
                        </label>
                        <select asp-for="MucDo" class="form-select">
                            @foreach (var item in Model.DanhSachMucDo)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="MucDo" class="text-danger small"></span>
                    </div>

                    @* Mô tả lỗi *@
                    <div class="mb-3">
                        <label asp-for="NoiDungLoi" class="form-label fw-semibold">
                            Mô tả chi tiết tình trạng lỗi <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="NoiDungLoi" class="form-control" rows="5"
                                  placeholder="Mô tả cụ thể hiện tượng hư hỏng, âm thanh lạ, đèn báo lỗi, thời điểm phát sinh lỗi..."></textarea>
                        <span asp-validation-for="NoiDungLoi" class="text-danger small"></span>
                        <div class="form-text small text-muted">Từ 10 đến 1000 ký tự. Mô tả càng kỹ sẽ giúp kỹ thuật viên chẩn đoán nhanh hơn.</div>
                    </div>
                </div>

                <div class="card-footer bg-light px-4 py-3 d-flex justify-content-between align-items-center border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Hủy
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-send-fill me-1"></i> Gửi phiếu tiếp nhận
                    </button>
                </div>
            </div>
        </form>
    </div>

    @* Hướng dẫn & Quy trình *@
    <div class="col-lg-4">
        <div class="card-enterprise mb-4">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <span class="fw-bold" style="color: #0f172a;">
                    <i class="bi bi-journal-text text-primary me-2"></i>Quy trình tiếp nhận
                </span>
            </div>
            <div class="card-body p-4">
                <div class="d-flex mb-3">
                    <div class="me-3 rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 28px; height: 28px; font-weight: 700; font-size: 0.85rem;">1</div>
                    <div>
                        <div class="fw-semibold">Gửi yêu cầu</div>
                        <div class="small text-muted">Phiếu khởi tạo với trạng thái <em>Chờ tiếp nhận</em>.</div>
                    </div>
                </div>
                <div class="d-flex mb-3">
                    <div class="me-3 rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 28px; height: 28px; font-weight: 700; font-size: 0.85rem;">2</div>
                    <div>
                        <div class="fw-semibold">Tiếp nhận & Chẩn đoán</div>
                        <div class="small text-muted">Kỹ thuật viên kiểm tra lỗi và đề xuất hướng xử lý.</div>
                    </div>
                </div>
                <div class="d-flex mb-3">
                    <div class="me-3 rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 28px; height: 28px; font-weight: 700; font-size: 0.85rem;">3</div>
                    <div>
                        <div class="fw-semibold">Sửa chữa linh kiện</div>
                        <div class="small text-muted">Thay thế, sửa chữa theo hạng mục chi tiết.</div>
                    </div>
                </div>
                <div class="d-flex">
                    <div class="me-3 rounded-circle bg-success text-white d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 28px; height: 28px; font-weight: 700; font-size: 0.85rem;">4</div>
                    <div>
                        <div class="fw-semibold">Bàn giao & Hoàn thành</div>
                        <div class="small text-muted">Nghiệm thu, cập nhật phiếu và bàn giao thiết bị.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-warning border-0 shadow-sm">
            <div class="fw-bold mb-1">
                <i class="bi bi-shield-exclamation me-1"></i> Lưu ý quy định:
            </div>
            <ul class="small mb-0 ps-3">
                <li>Bạn có quyền hủy phiếu khi đang ở trạng thái <strong>Chờ tiếp nhận</strong>.</li>
                <li>Mỗi thiết bị chỉ được tạo 1 phiếu đang xử lý đồng thời.</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
