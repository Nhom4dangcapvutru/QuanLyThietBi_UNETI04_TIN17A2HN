@* 
    Họ và tên: Nguyễn Thị Thảo
    Mã sinh viên: 23103100092
    Nội dung thực hiện: View danh sách phiếu sửa chữa
    (Tìm kiếm + Lọc + Sắp xếp + Phân trang)
*@
@model List<QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.PhieuSuaChua>

@{
    ViewData["Title"] = "Quản lý Phiếu sửa chữa";

    string? tuKhoa = ViewBag.TuKhoa as string;
    string? trangThai = ViewBag.TrangThai as string;
    string? sapXep = ViewBag.SapXep as string;
    int trangHienTai = ViewBag.TrangHienTai ?? 1;
    int tongSoTrang = ViewBag.TongSoTrang ?? 1;
    int tongSoBanGhi = ViewBag.TongSoBanGhi ?? 0;
    List<string> danhSachTrangThai = ViewBag.DanhSachTrangThai as List<string> ?? new List<string>();
}

<div class="container-fluid px-0">
    <!-- TIÊU ĐỀ DANH SÁCH PHIẾU -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">Danh sách Phiếu sửa chữa</h3>
            <p class="text-muted small mb-0">Theo dõi thông tin tiếp nhận sự cố, tiến độ thực hiện và lịch sử bảo hành</p>
        </div>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BỘ LỌC VÀ TÌM KIẾM -->
    <div class="card card-enterprise mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold text-secondary">Từ khóa tìm kiếm</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="tuKhoa" value="@tuKhoa"
                                   class="form-control border-start-0 ps-0"
                                   placeholder="Nội dung lỗi, tên thiết bị, serial..." />
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-secondary">Trạng thái xử lý</label>
                        <select name="trangThai" class="form-select">
                            <option value="">-- Tất cả trạng thái --</option>
                            @foreach (var tt in danhSachTrangThai)
                            {
                                <option value="@tt" selected="@(trangThai == tt)">@tt</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Sắp xếp</label>
                        <select name="sapXep" class="form-select">
                            <option value="">Mới nhất</option>
                            <option value="ngay_asc" selected="@(sapXep == "ngay_asc")">Cũ nhất</option>
                            <option value="trangthai" selected="@(sapXep == "trangthai")">Theo trạng thái</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-funnel"></i>
                            <span>Lọc</span>
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" title="Làm mới">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH DỮ LIỆU -->
    <div class="card card-enterprise">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">Danh sách dữ liệu</span>
            <span class="badge bg-light text-dark border">Tổng số: <strong>@tongSoBanGhi</strong> phiếu</span>
        </div>
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-enterprise mb-0 align-middle">
                    <thead>
                        <tr>
                            <th style="width: 90px;">Mã phiếu</th>
                            <th>Ngày tiếp nhận</th>
                            <th>Thiết bị</th>
                            <th>Nội dung sự cố</th>
                            <th>Mức độ</th>
                            <th>Trạng thái</th>
                            <th class="text-center" style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">#@p.MaPhieu</span>
                                </td>
                                <td>
                                    <div class="text-dark small">@p.NgayTiepNhan.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@p.NgayTiepNhan.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    @if (p.ThietBi != null)
                                    {
                                        <div class="fw-medium text-dark">@p.ThietBi.TenThietBi</div>
                                        <small class="text-muted font-monospace">S/N: @p.ThietBi.SerialNumber</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block text-secondary" style="max-width: 250px;" title="@p.NoiDungLoi">
                                        @(p.NoiDungLoi.Length > 55 ? p.NoiDungLoi.Substring(0, 55) + "..." : p.NoiDungLoi)
                                    </span>
                                </td>
                                <td>
                                    @if (p.MucDo == "Khẩn cấp")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Khẩn cấp</span>
                                    }
                                    else if (p.MucDo == "Cao")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Cao</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border">@p.MucDo</span>
                                    }
                                </td>
                                <td>
                                    <partial name="_TrangThaiPhieu" model="p.TrangThai" />
                                </td>
                                <td class="text-center">
                                    <div class="btn-action-group justify-content-center">
                                        <a asp-action="Details" asp-route-id="@p.MaPhieu"
                                           class="btn-action btn-action-view" title="Xem chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (p.TrangThai == "Chờ tiếp nhận")
                                        {
                                            <a asp-action="Huy" asp-route-id="@p.MaPhieu"
                                               class="btn-action btn-action-delete" title="Hủy phiếu này">
                                                <i class="bi bi-x-lg"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PHÂN TRANG -->
            @if (tongSoTrang > 1)
            {
                <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-between align-items-center py-3">
                    <span class="small text-muted mb-2 mb-sm-0">
                        Hiển thị trang <strong>@trangHienTai</strong> / <strong>@tongSoTrang</strong>
                    </span>
                    <nav>
                        <ul class="pagination pagination-enterprise mb-0 justify-content-center">
                            <li class="page-item @(trangHienTai > 1 ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-tuKhoa="@tuKhoa"
                                   asp-route-trangThai="@trangThai"
                                   asp-route-sapXep="@sapXep"
                                   asp-route-trang="@(trangHienTai - 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= tongSoTrang; i++)
                            {
                                <li class="page-item @(i == trangHienTai ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-tuKhoa="@tuKhoa"
                                       asp-route-trangThai="@trangThai"
                                       asp-route-sapXep="@sapXep"
                                       asp-route-trang="@i">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(trangHienTai < tongSoTrang ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-tuKhoa="@tuKhoa"
                                   asp-route-trangThai="@trangThai"
                                   asp-route-sapXep="@sapXep"
                                   asp-route-trang="@(trangHienTai + 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox text-muted fs-1 mb-2 d-block"></i>
                <p class="text-muted fw-medium mb-3">Không tìm thấy phiếu sửa chữa nào phù hợp điều kiện lọc.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Tạo phiếu mới
                </a>
            </div>
        }
    </div>
</div>
