@* Họ và tên: DINH THI THUY LINH
    MSV: 23103100110
   Nội dung thực hiện: Form cập nhật trạng thái và chi phí cuối *@

@model QuanLyThietBi_UNETI04_DHTI17A2HN.ViewModels.CapNhatTrangThaiViewModel
@{
    ViewData["Title"] = "Cập nhật trạng thái phiếu #" + Model.MaPhieu;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0f172a;">
            <i class="bi bi-arrow-repeat text-primary me-2"></i>Cập nhật trạng thái phiếu #@Model.MaPhieu
        </h3>
        <p class="text-muted small mb-0">Chuyển đổi trạng thái quy trình và chốt tổng chi phí nghiệm thu</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.MaPhieu" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại chi tiết
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="CapNhatTrangThai" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaPhieu" />
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

            <div class="card-enterprise mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <span class="fw-bold" style="color: #0f172a;">
                        <i class="bi bi-check2-circle text-primary me-2"></i>Thiết lập trạng thái mới
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="TrangThaiMoi" class="form-label fw-semibold">Trạng thái mới <span class="text-danger">*</span></label>
                        <select asp-for="TrangThaiMoi" asp-items="Model.DanhSachTrangThaiChoPhep" class="form-select">
                            <option value="">-- Chọn trạng thái tiếp theo --</option>
                        </select>
                        <span asp-validation-for="TrangThaiMoi" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NgayHenTra" class="form-label fw-semibold">Ngày hẹn trả thiết bị</label>
                            <input asp-for="NgayHenTra" type="date" class="form-control" />
                            <span asp-validation-for="NgayHenTra" class="text-danger small"></span>
                        </div>
                    </div>

                    <fieldset id="costBreakdown" class="mt-4">
                        <legend class="h6">Chi phí nghiệm thu khi hoàn thành</legend>
                        <p class="small text-muted">Tổng = linh kiện + tiền công + chi phí khác − giảm trừ. Nhập 0 nếu không phát sinh. Bảo hành được ghi nhận bằng khoản giảm trừ có lý do.</p>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="TienCong" class="form-label"></label>
                                <input asp-for="TienCong" type="number" min="0" max="1000000000000" step="0.01" class="form-control cost-input" />
                                <span asp-validation-for="TienCong" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="ChiPhiKhac" class="form-label"></label>
                                <input asp-for="ChiPhiKhac" type="number" min="0" max="1000000000000" step="0.01" class="form-control cost-input" />
                                <span asp-validation-for="ChiPhiKhac" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="NoiDungChiPhiKhac" class="form-label"></label>
                                <textarea asp-for="NoiDungChiPhiKhac" rows="2" class="form-control"></textarea>
                                <span asp-validation-for="NoiDungChiPhiKhac" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="GiamTru" class="form-label"></label>
                                <input asp-for="GiamTru" type="number" min="0" max="1000000000000" step="0.01" class="form-control cost-input" />
                                <span asp-validation-for="GiamTru" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="LyDoGiamTru" class="form-label"></label>
                                <textarea asp-for="LyDoGiamTru" rows="2" class="form-control"></textarea>
                                <span asp-validation-for="LyDoGiamTru" class="text-danger small"></span>
                            </div>
                        </div>
                    </fieldset>

                    <div class="mt-3">
                        <label asp-for="LyDoHuy" class="form-label fw-semibold">Lý do từ chối / hủy (nếu có)</label>
                        <textarea asp-for="LyDoHuy" class="form-control" rows="3"
                                  placeholder="Ghi rõ lý do hủy phiếu hoặc từ chối tiếp nhận..."></textarea>
                        <span asp-validation-for="LyDoHuy" class="text-danger small"></span>
                    </div>
                </div>

                <div class="card-footer bg-light px-4 py-3 d-flex justify-content-end gap-2 border-top">
                    <a asp-action="Details" asp-route-id="@Model.MaPhieu" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i> Lưu trạng thái
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card-enterprise h-100">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <span class="fw-bold" style="color: #0f172a;">
                    <i class="bi bi-receipt text-primary me-2"></i>Tổng kết chi phí & Thiết bị
                </span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5 text-muted">Khách hàng:</dt>
                    <dd class="col-sm-7 fw-bold text-dark">@Model.TenKhachHang</dd>

                    <dt class="col-sm-5 text-muted">Thiết bị:</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.TenThietBi</dd>

                    <dt class="col-sm-5 text-muted">Serial Number:</dt>
                    <dd class="col-sm-7"><span class="badge bg-light text-dark border">@Model.SerialNumber</span></dd>

                    <dt class="col-sm-5 text-muted">Trạng thái hiện tại:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-info text-dark">@Model.TrangThaiHienTai</span>
                    </dd>

                    <dt class="col-sm-5 text-muted">Bảo hành:</dt>
                    <dd class="col-sm-7">
                        @if (Model.ConBaoHanh)
                        {
                            <span class="badge bg-success">Còn bảo hành</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Hết hạn</span>
                        }
                    </dd>

                    <dt class="col-sm-5 text-muted">Tiền linh kiện đã xuất:</dt>
                    <dd class="col-sm-7 fw-bold text-danger">@Model.TongTienLinhKien.ToString("#,##0.##") VNĐ</dd>

                    @if (Model.ChiPhiDuKienHienThi.HasValue)
                    {
                        <dt class="col-sm-5 text-muted">Dự kiến ban đầu:</dt>
                        <dd class="col-sm-7 text-muted">@Model.ChiPhiDuKienHienThi.Value.ToString("#,##0.##") VNĐ</dd>
                    }
                </dl>
                <div id="costPreview" class="border-top mt-3 pt-3" data-parts="@Model.TongTienLinhKien.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <div class="fw-semibold">Tổng chi phí thực tế khi hoàn thành</div>
                    <output id="calculatedCost" class="fs-4 text-danger fw-bold" aria-live="polite"></output>
                    <p class="small text-muted mb-0">Tổng được kiểm tra lại khi lưu dựa trên các hạng mục linh kiện đã ghi nhận. Chưa xác nhận thanh toán.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/repair-costs.js" asp-append-version="true"></script>
}
