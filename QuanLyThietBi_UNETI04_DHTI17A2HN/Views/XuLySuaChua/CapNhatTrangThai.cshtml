@* Họ và tên: DINH THI THUY LINH
    MSV: 23103100110
   Nội dung thực hiện: Form cập nhật trạng thái và chi phí cuối *@

@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.ViewModels.CapNhatTrangThaiViewModel
@{
    ViewData["Title"] = "Cập nhật trạng thái phiếu #" + Model.MaPhieu;
}

<h2>🔄 Cập nhật trạng thái phiếu #@Model.MaPhieu</h2>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Khách hàng:</strong> @Model.TenKhachHang</p>
        <p><strong>Thiết bị:</strong> @Model.TenThietBi — S/N: @Model.SerialNumber</p>
        <p><strong>Trạng thái hiện tại:</strong>
            <span class="badge bg-info text-dark">@Model.TrangThaiHienTai</span>
        </p>
        <p>
            <strong>Bảo hành:</strong>
            @if (Model.ConBaoHanh)
            {
                <span class="badge bg-success">Còn bảo hành</span>
            }
            else
            {
                <span class="badge bg-danger">Hết bảo hành</span>
            }
        </p>
        <p><strong>Tiền linh kiện:</strong>
            <span class="text-danger fw-bold">@Model.TongTienLinhKien.ToString("N0") VNĐ</span>
        </p>
        @if (Model.ChiPhiDuKienHienThi.HasValue)
        {
            <p><strong>Chi phí dự kiến (tham khảo):</strong>
                @Model.ChiPhiDuKienHienThi.Value.ToString("N0") VNĐ</p>
        }
    </div>
</div>

<form asp-action="CapNhatTrangThai" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MaPhieu" />
    <input type="hidden" asp-for="TenKhachHang" />
    <input type="hidden" asp-for="TenThietBi" />
    <input type="hidden" asp-for="SerialNumber" />
    <input type="hidden" asp-for="TrangThaiHienTai" />
    <input type="hidden" asp-for="ConBaoHanh" />
    <input type="hidden" asp-for="TongTienLinhKien" />
    <input type="hidden" asp-for="ChiPhiDuKienHienThi" />

    <div class="mb-3">
        <label asp-for="TrangThaiMoi" class="form-label"></label>
        <select asp-for="TrangThaiMoi" asp-items="Model.DanhSachTrangThaiChoPhep" class="form-select">
            <option value="">-- Chọn trạng thái mới --</option>
        </select>
        <span asp-validation-for="TrangThaiMoi" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="TongChiPhi" class="form-label"></label>
            <input asp-for="TongChiPhi" type="number" step="1000" class="form-control" />
            <span asp-validation-for="TongChiPhi" class="text-danger"></span>
            <small class="text-muted">Bắt buộc khi chuyển sang "Hoàn thành"</small>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="NgayHenTra" class="form-label"></label>
            <input asp-for="NgayHenTra" type="date" class="form-control" />
            <span asp-validation-for="NgayHenTra" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="LyDoHuy" class="form-label"></label>
        <textarea asp-for="LyDoHuy" class="form-control" rows="2"
                  placeholder="Bắt buộc khi chọn Hủy / Từ chối..."></textarea>
        <span asp-validation-for="LyDoHuy" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">💾 Lưu trạng thái</button>
    <a asp-action="Details" asp-route-id="@Model.MaPhieu" class="btn btn-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}