@* Họ và tên: DINH THI THUY LINH
    MSV: 23103100110
   Nội dung thực hiện: Chi tiết phiếu sửa chữa *@

@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.PhieuSuaChua
@{
    ViewData["Title"] = "Chi tiết phiếu #" + Model.MaPhieu;
    var conBaoHanh = Model.ThietBi != null && DateTime.Now.Date <= Model.ThietBi.HanBaoHanh.Date;

    string badgeClass = Model.TrangThai switch
    {
        "Chờ tiếp nhận" => "badge-status-tiepnhan",
        "Đang xử lý" => "badge-status-dangsua",
        "Hoàn thành" => "badge-status-hoanthanh",
        "Đã hủy" => "badge-status-dahuy",
        "Từ chối tiếp nhận" => "badge-status-dahuy",
        _ => "badge-status-dangsua"
    };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <h3 class="fw-bold mb-0" style="color: #0f172a;">
                <i class="bi bi-file-earmark-medical text-primary me-2"></i>Chi tiết phiếu kỹ thuật #@Model.MaPhieu
            </h3>
            <span class="badge-status @badgeClass fs-6 px-3 py-1">@Model.TrangThai</span>
        </div>
        <p class="text-muted small mb-0">Quản lý trạng thái, tiến độ sửa chữa và vật tư thay thế</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Danh sách phiếu
        </a>

        @if (Model.TrangThai == "Chờ tiếp nhận")
        {
            <a asp-action="TiepNhan" asp-route-id="@Model.MaPhieu" class="btn btn-success">
                <i class="bi bi-box-arrow-in-down-right me-1"></i> Tiếp nhận phiếu
            </a>
        }
        @if (Model.TrangThai == "Đang xử lý")
        {
            <a asp-action="ChanDoan" asp-route-id="@Model.MaPhieu" class="btn btn-warning">
                <i class="bi bi-clipboard2-pulse me-1"></i> Chẩn đoán
            </a>
            <a asp-action="SuaChua" asp-route-id="@Model.MaPhieu" class="btn btn-info text-white">
                <i class="bi bi-tools me-1"></i> Thay thế vật tư
            </a>
        }
        @if (Model.TrangThai != "Hoàn thành" && Model.TrangThai != "Đã hủy" && Model.TrangThai != "Từ chối tiếp nhận")
        {
            <a asp-action="CapNhatTrangThai" asp-route-id="@Model.MaPhieu" class="btn btn-primary">
                <i class="bi bi-arrow-repeat me-1"></i> Đổi trạng thái
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4">
        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card-enterprise h-100">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <span class="fw-bold" style="color: #0f172a;">
                    <i class="bi bi-person text-primary me-2"></i>Khách hàng & Thiết bị
                </span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 small">
                    <dt class="col-sm-4 text-muted">Khách hàng:</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@(Model.KhachHang?.HoTen ?? "Chưa rõ")</dd>

                    <dt class="col-sm-4 text-muted">Số điện thoại:</dt>
                    <dd class="col-sm-8">@(Model.KhachHang?.SoDienThoai ?? "—")</dd>

                    <dt class="col-sm-4 text-muted">Tên thiết bị:</dt>
                    <dd class="col-sm-8 fw-semibold">@(Model.ThietBi?.TenThietBi ?? "—")</dd>

                    <dt class="col-sm-4 text-muted">Serial Number:</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">@(Model.ThietBi?.SerialNumber ?? "—")</span></dd>

                    <dt class="col-sm-4 text-muted">Tình trạng bảo hành:</dt>
                    <dd class="col-sm-8">
                        @if (conBaoHanh)
                        {
                            <span class="badge bg-success"><i class="bi bi-shield-check me-1"></i>Còn hạn (@Model.ThietBi?.HanBaoHanh.ToString("dd/MM/yyyy"))</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-shield-x me-1"></i>Hết bảo hành</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card-enterprise h-100">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <span class="fw-bold" style="color: #0f172a;">
                    <i class="bi bi-clock-history text-primary me-2"></i>Tiến trình & Kỹ thuật phụ trách
                </span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 small">
                    <dt class="col-sm-4 text-muted">Mức độ ưu tiên:</dt>
                    <dd class="col-sm-8">
                        @if (Model.MucDo == "Khẩn cấp")
                        {
                            <span class="badge bg-danger">Khẩn cấp</span>
                        }
                        else if (Model.MucDo == "Cao")
                        {
                            <span class="badge bg-warning text-dark">Cao</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Bình thường</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Ngày tiếp nhận:</dt>
                    <dd class="col-sm-8">@Model.NgayTiepNhan.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4 text-muted">KTV tiếp nhận:</dt>
                    <dd class="col-sm-8">@(Model.KyThuatVienTiepNhan?.HoTen ?? "Chưa phân công")</dd>

                    @if (Model.NgayHoanThanh.HasValue)
                    {
                        <dt class="col-sm-4 text-muted">Ngày hoàn thành:</dt>
                        <dd class="col-sm-8 text-success fw-bold">@Model.NgayHoanThanh.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.LyDoHuy))
                    {
                        <dt class="col-sm-4 text-muted">Lý do hủy:</dt>
                        <dd class="col-sm-8 text-danger">@Model.LyDoHuy</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card-enterprise mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom">
        <span class="fw-bold" style="color: #0f172a;">
            <i class="bi bi-chat-left-text text-primary me-2"></i>Nội dung sự cố & Báo cáo kỹ thuật
        </span>
    </div>
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="text-muted small fw-bold mb-1">Mô tả sự cố khách hàng báo:</div>
                    <div>@Model.NoiDungLoi</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-light border">
                    <div class="text-muted small fw-bold mb-1">Kết quả chẩn đoán kỹ thuật:</div>
                    <div>@(string.IsNullOrEmpty(Model.KetQuaChanDoan) ? "Chưa thực hiện chẩn đoán." : Model.KetQuaChanDoan)</div>
                </div>
            </div>
        </div>

    </div>
</div>

<partial name="_ChiPhiPhieu" model="Model" />

@* ===== DANH SÁCH LINH KIỆN ===== *@
@if (Model.ChiTietSuaChuas != null && Model.ChiTietSuaChuas.Any())
{
    <div class="card-enterprise mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold" style="color: #0f172a;">
                <i class="bi bi-cpu text-primary me-2"></i>Vật tư & Linh kiện đã sử dụng (@Model.ChiTietSuaChuas.Count)
            </span>
            <span class="fw-bold text-danger">
                Tổng tiền: @Model.ChiTietSuaChuas.Sum(c => c.ThanhTien).ToString("N0") VNĐ
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table-enterprise align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tên linh kiện</th>
                            <th class="text-center" style="width: 100px;">Số lượng</th>
                            <th class="text-end" style="width: 140px;">Đơn giá</th>
                            <th class="text-end" style="width: 150px;">Thành tiền</th>
                            <th>Kỹ thuật viên thực hiện</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ct in Model.ChiTietSuaChuas)
                        {
                            <tr>
                                <td><strong>@ct.LinhKien?.TenLinhKien</strong></td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@ct.SoLuong</span></td>
                                <td class="text-end text-muted">@ct.DonGia.ToString("N0") đ</td>
                                <td class="text-end"><strong class="text-dark">@ct.ThanhTien.ToString("N0") đ</strong></td>
                                <td><i class="bi bi-person me-1"></i>@(ct.KyThuatVien?.HoTen ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
