@* Họ và tên: DINH THI THUY LINH
    MSV: 23103100110
   Nội dung thực hiện: Chi tiết phiếu sửa chữa *@

@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.PhieuSuaChua
@{
    ViewData["Title"] = "Chi tiết phiếu #" + Model.MaPhieu;
    var conBaoHanh = Model.ThietBi != null && DateTime.Now.Date <= Model.ThietBi.HanBaoHanh.Date;
}

<h2>📄 Chi tiết phiếu #@Model.MaPhieu</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">Thông tin khách hàng & thiết bị</div>
            <div class="card-body">
                <p><strong>Khách hàng:</strong> @Model.KhachHang?.HoTen</p>
                <p><strong>SĐT:</strong> @Model.KhachHang?.SoDienThoai</p>
                <p><strong>Thiết bị:</strong> @Model.ThietBi?.TenThietBi</p>
                <p><strong>Serial:</strong> @Model.ThietBi?.SerialNumber</p>
                <p>
                    <strong>Bảo hành:</strong>
                    @if (conBaoHanh)
                    {
                        <span class="badge bg-success">Còn bảo hành (hạn @Model.ThietBi?.HanBaoHanh.ToString("dd/MM/yyyy"))</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Hết bảo hành</span>
                    }
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-info text-white">Trạng thái xử lý</div>
            <div class="card-body">
                <p>
                    <strong>Trạng thái:</strong>
                    @{
                        var badge = Model.TrangThai switch
                        {
                            "Chờ tiếp nhận" => "bg-warning text-dark",
                            "Đang xử lý" => "bg-info text-dark",
                            "Hoàn thành" => "bg-success",
                            "Đã hủy" => "bg-secondary",
                            "Từ chối tiếp nhận" => "bg-danger",
                            _ => "bg-light text-dark"
                        };
                    }
                    <span class="badge @badge">@Model.TrangThai</span>
                </p>
                <p><strong>Mức độ:</strong> @Model.MucDo</p>
                <p><strong>Ngày tiếp nhận:</strong> @Model.NgayTiepNhan.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>KTV tiếp nhận:</strong> @Model.KyThuatVienTiepNhan?.HoTen</p>
                @if (Model.NgayHoanThanh.HasValue)
                {
                    <p><strong>Ngày hoàn thành:</strong> @Model.NgayHoanThanh.Value.ToString("dd/MM/yyyy HH:mm")</p>
                }
                @if (!string.IsNullOrEmpty(Model.LyDoHuy))
                {
                    <p><strong>Lý do hủy:</strong> <span class="text-danger">@Model.LyDoHuy</span></p>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header bg-warning text-dark">Nội dung lỗi & Chẩn đoán</div>
    <div class="card-body">
        <p><strong>Nội dung lỗi:</strong> @Model.NoiDungLoi</p>
        @if (!string.IsNullOrEmpty(Model.KetQuaChanDoan))
        {
            <p><strong>Kết quả chẩn đoán:</strong> @Model.KetQuaChanDoan</p>
        }
        @if (Model.ChiPhiDuKien.HasValue)
        {
            <p><strong>Chi phí dự kiến:</strong> @Model.ChiPhiDuKien.Value.ToString("N0") VNĐ</p>
        }
        @if (Model.TongChiPhi.HasValue)
        {
            <p>
                <strong>Tổng chi phí thực tế:</strong>
                <span class="text-danger fw-bold">@Model.TongChiPhi.Value.ToString("N0") VNĐ</span>
            </p>
        }
    </div>
</div>

@* ===== DANH SÁCH LINH KIỆN ===== *@
@if (Model.ChiTietSuaChuas != null && Model.ChiTietSuaChuas.Any())
{
    <div class="card mb-3">
        <div class="card-header bg-secondary text-white">
            Linh kiện đã thay thế (@Model.ChiTietSuaChuas.Count)
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Linh kiện</th>
                        <th>SL</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                        <th>KTV</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ct in Model.ChiTietSuaChuas)
                    {
                        <tr>
                            <td>@ct.LinhKien?.TenLinhKien</td>
                            <td>@ct.SoLuong</td>
                            <td>@ct.DonGia.ToString("N0")</td>
                            <td>@ct.ThanhTien.ToString("N0")</td>
                            <td>@ct.KyThuatVien?.HoTen</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3" class="text-end">Tổng tiền linh kiện:</td>
                        <td colspan="2">@Model.ChiTietSuaChuas.Sum(c => c.ThanhTien).ToString("N0") VNĐ</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@* ===== NÚT THAO TÁC THEO TRẠNG THÁI ===== *@
<div class="mt-3">
    @if (Model.TrangThai == "Chờ tiếp nhận")
    {
        <a asp-action="TiepNhan" asp-route-id="@Model.MaPhieu" class="btn btn-success">
            ✅ Tiếp nhận phiếu
        </a>
    }
    @if (Model.TrangThai == "Đang xử lý")
    {
        <a asp-action="ChanDoan" asp-route-id="@Model.MaPhieu" class="btn btn-warning">
            🔍 Chẩn đoán
        </a>
        <a asp-action="SuaChua" asp-route-id="@Model.MaPhieu" class="btn btn-info">
            🔧 Sửa chữa
        </a>
    }
    @if (Model.TrangThai != "Hoàn thành" && Model.TrangThai != "Đã hủy" && Model.TrangThai != "Từ chối tiếp nhận")
    {
        <a asp-action="CapNhatTrangThai" asp-route-id="@Model.MaPhieu" class="btn btn-primary">
            🔄 Cập nhật trạng thái
        </a>
    }
    <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
</div>