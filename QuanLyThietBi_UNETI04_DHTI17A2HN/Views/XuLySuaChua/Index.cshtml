@* 
    Họ và tên: DINH THI THUY LINH
    MSV: 23103100110
    Nội dung thực hiện: Danh sách phiếu cần xử lý (Module 4)
*@
@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.ViewModels.PhieuCanXuLyIndexViewModel
@{
    ViewData["Title"] = "Quy trình Xử lý sửa chữa";
}

<div class="container-fluid px-0">
    <!-- TIÊU ĐỀ -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1 text-dark">Quy trình Xử lý & Chẩn đoán Kỹ thuật</h3>
            <p class="text-muted small mb-0">Điều phối kỹ thuật viên tiếp nhận, chẩn đoán, cập nhật linh kiện và tính chi phí sửa chữa</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 small">
                <i class="bi bi-person-gear me-1"></i>Bàn làm việc Kỹ thuật viên
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- FORM TÌM KIẾM + BỘ LỌC -->
    <div class="card card-enterprise mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-secondary">Tìm kiếm</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="searchString" value="@Model.SearchString"
                                   class="form-control border-start-0 ps-0" placeholder="KH / thiết bị / serial..." />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Trạng thái</label>
                        <select name="trangThai" class="form-select" asp-items="Model.TrangThaiList">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Mức độ ưu tiên</label>
                        <select name="mucDo" class="form-select" asp-items="Model.MucDoList">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Loại thiết bị</label>
                        <select name="maLoaiThietBi" class="form-select" asp-items="Model.LoaiThietBiList">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-secondary">Khoảng thời gian tiếp nhận</label>
                        <div class="input-group input-group-sm">
                            <input type="date" name="tuNgay" value="@Model.TuNgay?.ToString("yyyy-MM-dd")" class="form-control" />
                            <span class="input-group-text">-</span>
                            <input type="date" name="denNgay" value="@Model.DenNgay?.ToString("yyyy-MM-dd")" class="form-control" />
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 d-flex align-items-center gap-1">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>Làm mới bộ lọc</span>
                        </a>
                        <button type="submit" class="btn btn-primary btn-sm px-4 d-flex align-items-center gap-1">
                            <i class="bi bi-funnel"></i>
                            <span>Áp dụng lọc</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH -->
    <div class="card card-enterprise">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">Danh sách phiếu chờ xử lý kỹ thuật</span>
            <span class="badge bg-light text-dark border">Tổng số: <strong>@Model.TotalItems</strong> phiếu</span>
        </div>
        <div class="table-responsive">
            <table class="table table-enterprise mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 80px;">Mã</th>
                        <th>
                            <a class="text-decoration-none text-secondary" asp-action="Index"
                               asp-route-sortOrder="@ViewData["NameSort"]"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-mucDo="@Model.MucDo">
                                Khách hàng <i class="bi bi-arrow-down-up small"></i>
                            </a>
                        </th>
                        <th>Thiết bị</th>
                        <th>Nội dung sự cố</th>
                        <th>
                            <a class="text-decoration-none text-secondary" asp-action="Index"
                               asp-route-sortOrder="@ViewData["StatusSort"]"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-mucDo="@Model.MucDo">
                                Trạng thái <i class="bi bi-arrow-down-up small"></i>
                            </a>
                        </th>
                        <th>Mức độ</th>
                        <th>
                            <a class="text-decoration-none text-secondary" asp-action="Index"
                               asp-route-sortOrder="@ViewData["DateSort"]"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-mucDo="@Model.MucDo">
                                Ngày tiếp nhận <i class="bi bi-arrow-down-up small"></i>
                            </a>
                        </th>
                        <th class="text-center" style="width: 100px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachPhieu.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle text-success fs-1 mb-2 d-block"></i>
                                Không có phiếu sửa chữa nào cần xử lý lúc này.
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model.DanhSachPhieu)
                    {
                        <tr>
                            <td><span class="fw-bold font-monospace">#@p.MaPhieu</span></td>
                            <td>
                                <div class="fw-medium text-dark">@(p.KhachHang?.HoTen ?? "Khách vãng lai")</div>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">@p.ThietBi?.TenThietBi</div>
                                <small class="text-muted font-monospace">S/N: @p.ThietBi?.SerialNumber</small>
                            </td>
                            <td>
                                <span class="text-truncate d-inline-block text-secondary" style="max-width: 260px;" title="@p.NoiDungLoi">
                                    @(p.NoiDungLoi.Length > 50 ? p.NoiDungLoi.Substring(0, 50) + "..." : p.NoiDungLoi)
                                </span>
                            </td>
                            <td>
                                @if (p.TrangThai == "Chờ tiếp nhận")
                                {
                                    <span class="badge-status-tiepnhan">
                                        <i class="bi bi-hourglass-split"></i> Tiếp nhận
                                    </span>
                                }
                                else if (p.TrangThai == "Đang xử lý")
                                {
                                    <span class="badge-status-dangsua">
                                        <i class="bi bi-gear-wide-connected"></i> Đang sửa
                                    </span>
                                }
                                else if (p.TrangThai == "Hoàn thành")
                                {
                                    <span class="badge-status-hoanthanh">
                                        <i class="bi bi-check-circle-fill"></i> Hoàn thành
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status-dahuy">
                                        <i class="bi bi-x-circle-fill"></i> @p.TrangThai
                                    </span>
                                }
                            </td>
                            <td>
                                @if (p.MucDo == "Khẩn cấp")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Khẩn cấp</span>
                                }
                                else if (p.MucDo == "Cao")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Cao</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border">@p.MucDo</span>
                                }
                            </td>
                            <td>
                                <span class="text-secondary small">
                                    @p.NgayTiepNhan.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-action-group justify-content-center">
                                    <a asp-action="Details" asp-route-id="@p.MaPhieu"
                                       class="btn-action btn-action-view" title="Chẩn đoán & Xử lý kỹ thuật">
                                        <i class="bi bi-wrench-adjustable"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-between align-items-center py-3">
                <span class="small text-muted mb-2 mb-sm-0">
                    Trang <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong> (Tổng @Model.TotalItems phiếu)
                </span>
                <nav>
                    <ul class="pagination pagination-enterprise mb-0 justify-content-center">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageIndex="@(Model.PageIndex - 1)"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-mucDo="@Model.MucDo"
                               asp-route-maLoaiThietBi="@Model.MaLoaiThietBi"
                               asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                               asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                               asp-route-sortOrder="@Model.SortOrder">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageIndex="@i"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-mucDo="@Model.MucDo"
                                   asp-route-maLoaiThietBi="@Model.MaLoaiThietBi"
                                   asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                                   asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                                   asp-route-sortOrder="@Model.SortOrder">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageIndex="@(Model.PageIndex + 1)"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-mucDo="@Model.MucDo"
                               asp-route-maLoaiThietBi="@Model.MaLoaiThietBi"
                               asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                               asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                               asp-route-sortOrder="@Model.SortOrder">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
