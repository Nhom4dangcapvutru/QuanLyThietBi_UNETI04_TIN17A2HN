@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.LoaiThietBi
@{
    ViewData["Title"] = "Chi tiết loại thiết bị";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0f172a;">
            <i class="bi bi-tag-fill text-primary me-2"></i>Loại thiết bị: @Model.TenLoai
        </h3>
        <p class="text-muted small mb-0">Chi tiết quy chuẩn và danh sách thiết bị liên kết</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
        <a asp-action="Edit" asp-route-id="@Model.MaLoai" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Sửa loại thiết bị
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card-enterprise h-100">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <span class="fw-bold" style="color: #0f172a;">
                    <i class="bi bi-info-circle text-primary me-2"></i>Thông số quy chuẩn
                </span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted small">Mã loại:</dt>
                    <dd class="col-sm-7"><span class="badge bg-light text-dark border">#@Model.MaLoai</span></dd>

                    <dt class="col-sm-5 text-muted small">Tên loại:</dt>
                    <dd class="col-sm-7 fw-bold text-dark">@Model.TenLoai</dd>

                    <dt class="col-sm-5 text-muted small">Hãng sản xuất:</dt>
                    <dd class="col-sm-7"><span class="badge bg-light text-secondary border">@Model.HangSanXuat</span></dd>

                    <dt class="col-sm-5 text-muted small">Bảo hành mặc định:</dt>
                    <dd class="col-sm-7 fw-semibold text-success">
                        <i class="bi bi-shield-check me-1"></i>@Model.ThoiHanBaoHanhMacDinh tháng
                    </dd>

                    <dt class="col-sm-5 text-muted small">Số máy đã đăng ký:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-primary">@Model.ThietBis.Count thiết bị</span>
                    </dd>

                    <dt class="col-sm-5 text-muted small">Mô tả cấu hình:</dt>
                    <dd class="col-sm-7 small text-muted">@(Model.MoTa ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card-enterprise h-100">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-bold" style="color: #0f172a;">
                    <i class="bi bi-laptop text-primary me-2"></i>Thiết bị thuộc loại này (@Model.ThietBis.Count)
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table-enterprise align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Mã</th>
                                <th>Tên thiết bị</th>
                                <th>Serial Number</th>
                                <th>Trạng thái</th>
                                <th style="width: 80px;" class="text-end pe-3">Xem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ThietBis.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        Chưa có thiết bị nào thuộc loại này.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var tb in Model.ThietBis)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark border">#@tb.MaThietBi</span></td>
                                        <td><strong class="text-dark">@tb.TenThietBi</strong></td>
                                        <td><span class="badge bg-light text-secondary border">@tb.SerialNumber</span></td>
                                        <td><span class="badge bg-primary">@tb.TrangThai</span></td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="ThietBi" asp-action="Details" asp-route-id="@tb.MaThietBi"
                                               class="btn-action btn-action-view" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
