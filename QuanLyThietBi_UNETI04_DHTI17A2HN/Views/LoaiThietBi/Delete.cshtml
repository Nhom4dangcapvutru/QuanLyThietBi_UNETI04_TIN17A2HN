@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.LoaiThietBi
@{
    ViewData["Title"] = "Xóa loại thiết bị";
    bool coThietBi = Model.ThietBis.Any();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-danger">
            <i class="bi bi-trash-fill me-2"></i>Xóa Loại thiết bị #@Model.MaLoai
        </h3>
        <p class="text-muted small mb-0">Xác nhận xóa danh mục phân loại khỏi cơ sở dữ liệu</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

@if (coThietBi)
{
    <div class="alert alert-danger d-flex align-items-center mb-4">
        <i class="bi bi-x-circle-fill me-2 fs-5"></i>
        <div>
            <strong>Không thể xóa:</strong> Loại thiết bị này đang có <strong>@Model.ThietBis.Count thiết bị</strong> tham chiếu.
            Vui lòng xóa hoặc chuyển các thiết bị sang loại khác trước khi thực hiện.
        </div>
    </div>
}
else
{
    <div class="alert alert-warning d-flex align-items-center mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <div>
            <strong>Cảnh báo:</strong> Thao tác xóa sẽ loại bỏ vĩnh viễn cấu hình này khỏi hệ thống.
        </div>
    </div>
}

<div class="row">
    <div class="col-lg-7">
        <div class="card-enterprise mb-4">
            <div class="card-header bg-white py-3 px-4 border-bottom">
                <span class="fw-bold text-danger">
                    <i class="bi bi-tag me-2"></i>Thông tin loại thiết bị cần xóa
                </span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small">Mã loại:</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark border">#@Model.MaLoai</span></dd>

                    <dt class="col-sm-4 text-muted small">Tên loại:</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Model.TenLoai</dd>

                    <dt class="col-sm-4 text-muted small">Hãng sản xuất:</dt>
                    <dd class="col-sm-8">@Model.HangSanXuat</dd>

                    <dt class="col-sm-4 text-muted small">Bảo hành mặc định:</dt>
                    <dd class="col-sm-8">@Model.ThoiHanBaoHanhMacDinh tháng</dd>

                    <dt class="col-sm-4 text-muted small">Mô tả:</dt>
                    <dd class="col-sm-8 text-muted small">@(Model.MoTa ?? "—")</dd>
                </dl>
            </div>
            <div class="card-footer bg-light px-4 py-3 d-flex justify-content-between align-items-center border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Hủy, quay lại
                </a>

                @if (!coThietBi)
                {
                    <form asp-action="Delete" method="post" class="m-0">
                        <input type="hidden" asp-for="MaLoai" />
                        <button type="submit" class="btn btn-danger"
                                onclick="return confirm('Bạn có chắc chắn muốn xóa loại thiết bị @Model.TenLoai?');">
                            <i class="bi bi-trash me-1"></i> Xác nhận xóa
                        </button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn btn-danger" disabled>
                        <i class="bi bi-slash-circle me-1"></i> Bị khóa xóa
                    </button>
                }
            </div>
        </div>
    </div>
</div>
