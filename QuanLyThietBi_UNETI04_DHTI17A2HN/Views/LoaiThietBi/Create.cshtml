@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.LoaiThietBi
@{
    ViewData["Title"] = "Thêm loại thiết bị";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0f172a;">
            <i class="bi bi-tag-fill text-primary me-2"></i>Thêm Loại thiết bị mới
        </h3>
        <p class="text-muted small mb-0">Tạo danh mục phân loại thiết bị và cấu hình bảo hành mặc định</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

            <div class="card-enterprise mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <span class="fw-bold" style="color: #0f172a;">
                        <i class="bi bi-info-circle text-primary me-2"></i>Thông tin loại thiết bị
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="TenLoai" class="form-label fw-semibold">Tên loại thiết bị <span class="text-danger">*</span></label>
                            <input asp-for="TenLoai" class="form-control" placeholder="VD: Laptop Gaming, Máy in đa năng..." />
                            <span asp-validation-for="TenLoai" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HangSanXuat" class="form-label fw-semibold">Hãng sản xuất <span class="text-danger">*</span></label>
                            <input asp-for="HangSanXuat" class="form-control" placeholder="VD: Dell, ASUS, HP, Apple..." />
                            <span asp-validation-for="HangSanXuat" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ThoiHanBaoHanhMacDinh" class="form-label fw-semibold">Bảo hành mặc định (tháng) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="ThoiHanBaoHanhMacDinh" class="form-control" type="number" min="1" max="120" />
                                <span class="input-group-text">tháng</span>
                            </div>
                            <span asp-validation-for="ThoiHanBaoHanhMacDinh" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="MoTa" class="form-label fw-semibold">Mô tả chi tiết</label>
                            <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Mô tả đặc điểm loại thiết bị..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light px-4 py-3 d-flex justify-content-end gap-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i> Lưu loại thiết bị
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
