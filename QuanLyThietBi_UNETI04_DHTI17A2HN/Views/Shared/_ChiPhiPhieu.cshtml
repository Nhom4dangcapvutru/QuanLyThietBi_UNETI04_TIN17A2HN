@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Entities.PhieuSuaChua
@using QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Constants
@{
    var hoanThanh = Model.TrangThai == TrangThaiPhieu.HoanThanh;
    var tienLinhKien = Model.ChiTietSuaChuas.Sum(c => c.ThanhTien);
}
<section class="card-enterprise mb-4" aria-label="Chi phí sửa chữa">
    <div class="card-header">Chi phí sửa chữa</div>
    <div class="card-body p-3 p-md-4">
        <dl class="row mb-0">
            <dt class="col-sm-7 text-muted">Chi phí dự kiến (tham khảo)</dt>
            <dd class="col-sm-5 text-sm-end">@(Model.ChiPhiDuKien.HasValue ? Model.ChiPhiDuKien.Value.ToString("#,##0.##") + " VNĐ" : "Chưa báo giá")</dd>
            @if (hoanThanh && Model.CoPhanTichChiPhi)
            {
                <dt class="col-sm-7">Tiền linh kiện khi nghiệm thu</dt>
                <dd class="col-sm-5 text-sm-end">@Model.TienLinhKienChot!.Value.ToString("#,##0.##") VNĐ</dd>
                <dt class="col-sm-7">Tiền công sửa chữa</dt>
                <dd class="col-sm-5 text-sm-end">@Model.TienCong!.Value.ToString("#,##0.##") VNĐ</dd>
                <dt class="col-sm-7">Chi phí khác</dt>
                <dd class="col-sm-5 text-sm-end">@Model.ChiPhiKhac!.Value.ToString("#,##0.##") VNĐ</dd>
                @if (Model.ChiPhiKhac > 0) { <dd class="col-12 text-muted small">@Model.NoiDungChiPhiKhac</dd> }
                <dt class="col-sm-7">Giảm trừ bảo hành / ưu đãi</dt>
                <dd class="col-sm-5 text-sm-end text-success">− @Model.GiamTru!.Value.ToString("#,##0.##") VNĐ</dd>
                @if (Model.GiamTru > 0) { <dd class="col-12 text-muted small">@Model.LyDoGiamTru</dd> }
            }
            else
            {
                <dt class="col-sm-7">Tiền linh kiện đã ghi nhận</dt>
                <dd class="col-sm-5 text-sm-end">@tienLinhKien.ToString("#,##0.##") VNĐ</dd>
            }
            @if (hoanThanh)
            {
                <dt class="col-sm-7 border-top pt-3">Tổng chi phí thực tế</dt>
                <dd class="col-sm-5 border-top pt-3 text-sm-end fw-bold text-danger fs-5">@(Model.TongChiPhi.HasValue ? Model.TongChiPhi.Value.ToString("#,##0.##") + " VNĐ" : "Chưa ghi nhận")</dd>
            }
            else
            {
                <dd class="col-12 text-muted mb-0">Tổng chi phí thực tế sẽ được chốt khi nghiệm thu hoàn thành.</dd>
            }
        </dl>
        @if (hoanThanh && !Model.CoPhanTichChiPhi)
        {
            <div class="alert alert-warning mt-3 mb-0">Chưa có phân tích chi phí đầy đủ cho phiếu cũ. Tổng đã ghi nhận được giữ nguyên; tiền linh kiện không phải toàn bộ chi phí.</div>
        }
        @if (hoanThanh)
        {
            <p class="small text-muted mt-3 mb-0">Đây là chi phí nghiệm thu của phiếu, chưa xác nhận tình trạng thanh toán.</p>
        }
    </div>
</section>
