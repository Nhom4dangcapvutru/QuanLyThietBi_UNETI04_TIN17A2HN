@using Microsoft.AspNetCore.Http
@using QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Constants
@{
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
    var isLogged = !string.IsNullOrEmpty(vaiTro);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyThietBi_UNETI04_DHTI17A2HN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyThietBi_UNETI04_DHTI17A2HN.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">🛠️ QL Sửa Chữa Thiết Bị</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        @* Module 1: Chỉ Admin được xem Loại thiết bị và Tài khoản *@
                        @if (isLogged && vaiTro == VaiTroConstant.Admin)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-controller="LoaiThietBi" asp-action="Index">📦 Loại thiết bị</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-controller="TaiKhoan" asp-action="Index">👥 Tài khoản</a>
                            </li>
                        }

                        @* Module 2: Quản lý thiết bị *@
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="ThietBi" asp-action="Index">💻 Thiết bị</a>
                        </li>

                        @* Module 3: Khách hàng & Phiếu sửa chữa *@
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="KhachHang" asp-action="Index">👤 Khách hàng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="PhieuSuaChua" asp-action="Index">📋 Phiếu sửa chữa</a>
                        </li>

                        @* Module 4: Xử lý sửa chữa *@
                        <li class="nav-item">
                            <a class="nav-link text-primary fw-bold" asp-controller="XuLySuaChua" asp-action="Index">⚙️ Xử lý sửa chữa</a>
                        </li>
                    </ul>

                    @* Khu vực tài khoản / Đăng nhập bên phải *@
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (isLogged)
                        {
                            <li class="nav-item me-2">
                                <span class="badge bg-primary fs-6 py-2 px-3">
                                    👤 @(string.IsNullOrEmpty(hoTen) ? tenDangNhap : hoTen) <small class="text-light">(@vaiTro)</small>
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout">🚪 Đăng xuất</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3 fw-bold" asp-controller="Account" asp-action="Login">🔐 Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - QuanLyThietBi_UNETI04_DHTI17A2HN - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
