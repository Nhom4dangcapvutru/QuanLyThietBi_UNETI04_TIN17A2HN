@using Microsoft.AspNetCore.Http
@using QuanLyThietBi_UNETI04_DHTI17A2HN.Models.Constants
@{
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
    var isLogged = !string.IsNullOrEmpty(vaiTro);
    var isAdminOrKtv = vaiTro == VaiTroConstant.Admin || vaiTro == VaiTroConstant.KyThuatVien;
    var isKhachHang = vaiTro == VaiTroConstant.KhachHang;
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    
    // Tạo chữ cái đại diện cho avatar
    var avatarLetter = !string.IsNullOrEmpty(hoTen) ? hoTen.Trim().Substring(0, 1).ToUpper() : (!string.IsNullOrEmpty(tenDangNhap) ? tenDangNhap.Substring(0, 1).ToUpper() : "U");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI Repair Hub</title>
    
    <!-- Google Font: Inter & Bootstrap Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- SIDEBAR TRÁI CỐ ĐỊNH -->
        <aside class="app-sidebar" id="appSidebar">
            <!-- Sidebar Brand / Logo -->
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand text-decoration-none">
                <div class="brand-icon">
                    <i class="bi bi-cpu-fill"></i>
                </div>
                <div>
                    <div>UNETI REPAIR HUB</div>
                    <span class="brand-sub">Trung tâm Sửa chữa UNETI</span>
                </div>
            </a>

            <!-- Sidebar Navigation Menu Phân quyền theo Mục 17.1 & 17.2 -->
            <ul class="sidebar-menu">
                @* ==========================================
                   17.1. PHÍA NGƯỜI DÙNG (KHÁCH HÀNG)
                   ========================================== *@
                @if (isKhachHang)
                {
                    <li class="menu-header">KHÁCH HÀNG</li>
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="nav-link-custom @(currentCtrl == "Home" ? "active" : "")">
                            <i class="bi bi-house-door-fill"></i>
                            <span>Trang chủ</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Profile" asp-action="Index" class="nav-link-custom @(currentCtrl == "Profile" ? "active" : "")">
                            <i class="bi bi-person-badge-fill"></i>
                            <span>Thông tin cá nhân</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="ThietBi" asp-action="Index" class="nav-link-custom @(currentCtrl == "ThietBi" ? "active" : "")">
                            <i class="bi bi-laptop"></i>
                            <span>Danh sách thiết bị</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="PhieuSuaChua" asp-action="Create" class="nav-link-custom @(currentCtrl == "PhieuSuaChua" && currentAct == "Create" ? "active" : "")">
                            <i class="bi bi-plus-circle-fill"></i>
                            <span>Tạo phiếu sửa chữa</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="PhieuSuaChua" asp-action="Index" class="nav-link-custom @(currentCtrl == "PhieuSuaChua" && currentAct != "Create" ? "active" : "")">
                            <i class="bi bi-clock-history"></i>
                            <span>Danh sách giao dịch</span>
                        </a>
                    </li>
                }
                @* ==========================================
                   17.2. PHÍA NHÂN VIÊN / ADMIN
                   ========================================== *@
                else if (isAdminOrKtv)
                {
                    <li class="menu-header">BẢNG ĐIỀU KHIỂN</li>
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="nav-link-custom @(currentCtrl == "Home" ? "active" : "")">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Trang quản trị</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Dashboard" asp-action="Index" class="nav-link-custom @(currentCtrl == "Dashboard" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard chỉ số</span>
                        </a>
                    </li>

                    @* DỮ LIỆU NỀN (Chỉ Admin) *@
                    @if (vaiTro == VaiTroConstant.Admin)
                    {
                        <li class="menu-header">DỮ LIỆU NỀN</li>
                        <li>
                            <a asp-controller="LoaiThietBi" asp-action="Index" class="nav-link-custom @(currentCtrl == "LoaiThietBi" ? "active" : "")">
                                <i class="bi bi-tags"></i>
                                <span>Loại thiết bị</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="TaiKhoan" asp-action="Index" class="nav-link-custom @(currentCtrl == "TaiKhoan" ? "active" : "")">
                                <i class="bi bi-people"></i>
                                <span>Tài khoản người dùng</span>
                            </a>
                        </li>
                    }

                    <li class="menu-header">QUẢN TRỊ DỊCH VỤ</li>
                    <li>
                        <a asp-controller="ThietBi" asp-action="Index" class="nav-link-custom @(currentCtrl == "ThietBi" ? "active" : "")">
                            <i class="bi bi-laptop"></i>
                            <span>Quản lý thiết bị</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="KhachHang" asp-action="Index" class="nav-link-custom @(currentCtrl == "KhachHang" ? "active" : "")">
                            <i class="bi bi-person-lines-fill"></i>
                            <span>Quản lý khách hàng</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="PhieuSuaChua" asp-action="Index" class="nav-link-custom @(currentCtrl == "PhieuSuaChua" ? "active" : "")">
                            <i class="bi bi-receipt-cutoff"></i>
                            <span>Quản lý phiếu sửa chữa</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="XuLySuaChua" asp-action="Index" class="nav-link-custom @(currentCtrl == "XuLySuaChua" ? "active" : "")">
                            <i class="bi bi-gear-wide-connected"></i>
                            <span>Xử lý trạng thái</span>
                        </a>
                    </li>

                    <li class="menu-header">BÁO CÁO & THỐNG KÊ</li>
                    <li>
                        <a asp-controller="ThongKe" asp-action="Index" class="nav-link-custom @(currentCtrl == "ThongKe" ? "active" : "")">
                            <i class="bi bi-bar-chart-line"></i>
                            <span>Thống kê doanh thu</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="ChiTietSuaChuas" asp-action="Index" class="nav-link-custom @(currentCtrl == "ChiTietSuaChuas" ? "active" : "")">
                            <i class="bi bi-tools"></i>
                            <span>Chi tiết linh kiện</span>
                        </a>
                    </li>
                }
                @* ==========================================
                   KHI CHƯA ĐĂNG NHẬP
                   ========================================== *@
                else
                {
                    <li class="menu-header">HỆ THỐNG</li>
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="nav-link-custom @(currentCtrl == "Home" ? "active" : "")">
                            <i class="bi bi-house-door-fill"></i>
                            <span>Trang chủ</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="ThietBi" asp-action="Index" class="nav-link-custom @(currentCtrl == "ThietBi" ? "active" : "")">
                            <i class="bi bi-laptop"></i>
                            <span>Danh sách thiết bị</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="PhieuSuaChua" asp-action="Index" class="nav-link-custom @(currentCtrl == "PhieuSuaChua" ? "active" : "")">
                            <i class="bi bi-receipt-cutoff"></i>
                            <span>Phiếu sửa chữa</span>
                        </a>
                    </li>
                }
            </ul>

            <!-- Sidebar Footer -->
            <div class="sidebar-footer">
                @if (isLogged)
                {
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Đăng nhập</span>
                    </a>
                }
            </div>
        </aside>

        <!-- MAIN APP WRAPPER -->
        <div class="app-main">
            <!-- TOPBAR TRÊN CÙNG CỐ ĐỊNH -->
            <header class="app-topbar">
                <div class="topbar-left">
                    <button class="topbar-btn-icon d-lg-none" id="sidebarToggle" type="button" aria-label="Toggle Navigation">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <!-- Global Search -->
                    <div class="topbar-search d-none d-sm-block">
                        <i class="bi bi-search"></i>
                        <form asp-controller="PhieuSuaChua" asp-action="Index" method="get">
                            <input type="text" name="tuKhoa" class="form-control" placeholder="Tìm kiếm phiếu, thiết bị, serial..." />
                        </form>
                    </div>
                </div>

                <div class="topbar-right">
                    <!-- Shortcut Nút Lập phiếu mới -->
                    @if (isKhachHang || isAdminOrKtv)
                    {
                        <a asp-controller="PhieuSuaChua" asp-action="Create" class="btn btn-primary btn-sm d-none d-md-flex align-items-center gap-1 shadow-sm">
                            <i class="bi bi-plus-lg"></i>
                            <span>@(isKhachHang ? "Tạo phiếu sửa chữa" : "Tiếp nhận phiếu")</span>
                        </a>
                    }

                    <!-- Status Indicator -->
                    <span class="badge bg-success-subtle text-success border border-success-subtle d-none d-lg-inline-flex align-items-center gap-1 px-2 py-1">
                        <span class="spinner-grow spinner-grow-sm text-success" style="width: 8px; height: 8px;" role="status"></span>
                        Trực tuyến
                    </span>

                    <!-- Chuông thông báo -->
                    @if (isAdminOrKtv)
                    {
                        <a asp-controller="XuLySuaChua" asp-action="Index" class="topbar-btn-icon text-secondary" title="Phiếu cần xử lý">
                            <i class="bi bi-bell"></i>
                            <span class="topbar-badge-dot"></span>
                        </a>
                    }

                    <!-- User Account Dropdown -->
                    @if (isLogged)
                    {
                        <div class="dropdown">
                            <div class="topbar-user" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar">
                                    @avatarLetter
                                </div>
                                <div class="user-info d-none d-md-flex">
                                    <span class="user-name">@(string.IsNullOrEmpty(hoTen) ? tenDangNhap : hoTen)</span>
                                    <span class="user-role-badge">@vaiTro</span>
                                </div>
                                <i class="bi bi-chevron-down text-muted small ms-1"></i>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2 mt-2" style="border-radius: 12px; min-width: 220px;">
                                <li class="px-3 py-2 border-bottom mb-1">
                                    <div class="fw-bold text-dark">@(string.IsNullOrEmpty(hoTen) ? tenDangNhap : hoTen)</div>
                                    <small class="text-muted d-block">Vai trò: <span class="badge bg-primary-subtle text-primary">@vaiTro</span></small>
                                </li>
                                @if (isKhachHang)
                                {
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                                            <i class="bi bi-person-badge-fill text-primary"></i> Thông tin cá nhân
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                                            <i class="bi bi-speedometer2 text-primary"></i> Trang quản trị
                                        </a>
                                    </li>
                                }
                                @if (vaiTro == VaiTroConstant.Admin)
                                {
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="TaiKhoan" asp-action="Index">
                                            <i class="bi bi-people text-secondary"></i> Quản trị tài khoản
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger d-flex align-items-center gap-2" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right"></i> Đăng xuất hệ thống
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Đăng nhập</span>
                        </a>
                    }
                </div>
            </header>

            <!-- MAIN BODY CONTENT -->
            <main class="app-content">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="app-footer">
                <div>
                    <strong>UNETI REPAIR HUB</strong> &copy; 2026 - Nhóm 04 - DHTI17A2HN - Đại học Kinh tế - Kỹ thuật Công nghiệp
                </div>
                <div class="d-none d-md-block text-muted">
                    Phiên bản Enterprise v2.0
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Sidebar Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('appSidebar');
            const toggleBtn = document.getElementById('sidebarToggle');
            
            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                });
                
                // Close sidebar when clicking outside on mobile
                document.addEventListener('click', function (e) {
                    if (window.innerWidth < 992) {
                        if (!sidebar.contains(e.target) && !toggleBtn.contains(e.target) && sidebar.classList.contains('show')) {
                            sidebar.classList.remove('show');
                        }
                    }
                });
            }
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
