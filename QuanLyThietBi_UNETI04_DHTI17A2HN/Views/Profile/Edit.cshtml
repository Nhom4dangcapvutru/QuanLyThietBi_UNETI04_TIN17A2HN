@* 
    Họ và tên: Nguyễn Thị Thảo
    Mã sinh viên: 23103100092
    Nội dung thực hiện: View sửa hồ sơ cá nhân
    (Chỉ cho khách hàng sửa SĐT, Email, Địa chỉ, CCCD)
*@
@model QuanLyThietBi_UNETI04_DHTI17A2HN.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Cập nhật hồ sơ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: #0f172a;">
            <i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật hồ sơ cá nhân
        </h3>
        <p class="text-muted small mb-0">Cập nhật thông tin liên lạc và định danh khách hàng</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại hồ sơ
    </a>
</div>

<div class="alert alert-info d-flex align-items-center mb-4">
    <i class="bi bi-info-circle-fill me-2 fs-5"></i>
    <div>
        <strong>Lưu ý:</strong> Bạn chỉ có thể cập nhật <strong>Số điện thoại, Email, Địa chỉ và CCCD</strong>.
        Họ tên và Loại khách hàng do nhân viên hệ thống quản lý.
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="MaKhachHang" />
            <input type="hidden" asp-for="HoTen" />
            <input type="hidden" asp-for="LoaiKhachHang" />

            @* Thông tin cố định *@
            <div class="card-enterprise mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <span class="fw-bold text-muted small text-uppercase">
                        <i class="bi bi-lock me-1"></i> Thông tin cố định
                    </span>
                </div>
                <div class="card-body p-4 bg-light">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Mã khách hàng</label>
                            <input type="text" class="form-control" value="#@Model.MaKhachHang" readonly disabled />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Họ và tên</label>
                            <input type="text" class="form-control" value="@Model.HoTen" readonly disabled />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Loại khách hàng</label>
                            <input type="text" class="form-control" value="@Model.LoaiKhachHang" readonly disabled />
                        </div>
                    </div>
                </div>
            </div>

            @* Thông tin chỉnh sửa *@
            <div class="card-enterprise mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <span class="fw-bold" style="color: #0f172a;">
                        <i class="bi bi-pencil text-primary me-1"></i> Thông tin liên hệ có thể cập nhật
                    </span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold">Số điện thoại</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="SoDienThoai" class="form-control" placeholder="VD: 0901234567" />
                            </div>
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Địa chỉ Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="VD: email@gmail.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CCCD" class="form-label fw-semibold">Căn cước công dân (CCCD)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-card-heading"></i></span>
                                <input asp-for="CCCD" class="form-control" placeholder="9 - 12 chữ số" />
                            </div>
                            <span asp-validation-for="CCCD" class="text-danger small"></span>
                        </div>

                        @if (Model.LoaiKhachHang == "Doanh nghiệp")
                        {
                            <div class="col-md-6">
                                <label asp-for="MaSoThue" class="form-label fw-semibold">Mã số thuế</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-file-earmark-text"></i></span>
                                    <input asp-for="MaSoThue" class="form-control" />
                                </div>
                                <span asp-validation-for="MaSoThue" class="text-danger small"></span>
                            </div>
                        }

                        <div class="col-12">
                            <label asp-for="DiaChi" class="form-label fw-semibold">Địa chỉ liên hệ</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <textarea asp-for="DiaChi" class="form-control" rows="3" placeholder="Nhập địa chỉ nhận hàng / liên hệ..."></textarea>
                            </div>
                            <span asp-validation-for="DiaChi" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light px-4 py-3 d-flex justify-content-end gap-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle me-1"></i> Lưu thông tin
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
