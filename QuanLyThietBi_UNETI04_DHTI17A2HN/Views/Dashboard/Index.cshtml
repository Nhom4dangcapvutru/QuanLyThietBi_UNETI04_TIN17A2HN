@model QuanLyThietBi_UNETI04_DHTI17A2HN.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển KPI & Doanh thu";
    
    var tongPhieu = Model.TongSoGiaoDich > 0 ? Model.TongSoGiaoDich : 1;
    var pctChoXuLy = (Model.SoGiaoDichChoXuLy * 100) / tongPhieu;
    var pctDangXuLy = (Model.SoGiaoDichDangXuLy * 100) / tongPhieu;
    var pctHoanThanh = (Model.SoGiaoDichHoanThanh * 100) / tongPhieu;
}

<div class="container-fluid px-0">
    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h3 class="fw-bold mb-0 text-dark">Bảng chỉ số KPI & Điều hành Dịch vụ</h3>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-speedometer2 me-1"></i>Hệ thống giám sát
                </span>
            </div>
            <p class="text-muted small mb-0">Theo dõi định lượng hiệu suất sửa chữa, tỷ lệ hoàn tất và doanh số tích lũy</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="badge bg-light text-secondary border px-3 py-2 small">
                <i class="bi bi-clock-history me-1"></i>Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </span>
            <a asp-controller="ThongKe" asp-action="Index" class="btn btn-primary btn-sm d-flex align-items-center gap-2 shadow-sm px-3 py-2">
                <i class="bi bi-bar-chart-line-fill"></i>
                <span class="fw-semibold">Thống kê nâng cao</span>
            </a>
        </div>
    </div>

    <!-- HÀNG THẺ KPI -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-enterprise h-100 p-3 mb-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Loại thiết bị</span>
                        <h2 class="fw-bold text-dark my-1">@Model.TongSoLoaiThietBi</h2>
                        <span class="text-muted small">Phân loại danh mục</span>
                    </div>
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: #f3e8ff; color: #9333ea; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                        <i class="bi bi-tags-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-enterprise h-100 p-3 mb-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Tổng thiết bị</span>
                        <h2 class="fw-bold text-dark my-1">@Model.TongSoThietBi</h2>
                        <span class="text-muted small">
                            <i class="bi bi-check-circle-fill text-success me-1"></i>@Model.SoThietBiKhaDung khả dụng
                        </span>
                    </div>
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                        <i class="bi bi-laptop"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-enterprise h-100 p-3 mb-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Khách hàng</span>
                        <h2 class="fw-bold text-info my-1">@Model.TongSoKhachHang</h2>
                        <span class="text-muted small">Hồ sơ cá nhân & DN</span>
                    </div>
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-enterprise h-100 p-3 mb-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Tổng phiếu SC</span>
                        <h2 class="fw-bold text-dark my-1">@Model.TongSoGiaoDich</h2>
                        <span class="text-muted small">Toàn bộ lịch sử</span>
                    </div>
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: #f1f5f9; color: #475569; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG TIẾN ĐỘ 3 TRẠNG THÁI -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card card-enterprise p-3 mb-0" style="border-top: 3px solid #f59e0b;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold text-muted text-uppercase">Chờ tiếp nhận</span>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">@pctChoXuLy%</span>
                </div>
                <h3 class="fw-bold text-warning mb-2">@Model.SoGiaoDichChoXuLy</h3>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-warning" style="width: @pctChoXuLy%"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card card-enterprise p-3 mb-0" style="border-top: 3px solid #3b82f6;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold text-muted text-uppercase">Đang xử lý</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@pctDangXuLy%</span>
                </div>
                <h3 class="fw-bold text-primary mb-2">@Model.SoGiaoDichDangXuLy</h3>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-primary" style="width: @pctDangXuLy%"></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card card-enterprise p-3 mb-0" style="border-top: 3px solid #10b981;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold text-muted text-uppercase">Hoàn thành</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">@pctHoanThanh%</span>
                </div>
                <h3 class="fw-bold text-success mb-2">@Model.SoGiaoDichHoanThanh</h3>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-success" style="width: @pctHoanThanh%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- BANNER DOANH THU -->
    <div class="card card-enterprise p-4 mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; border: none;">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="text-uppercase small fw-bold" style="color: #94a3b8;">
                    <i class="bi bi-cash-stack me-1"></i>Tổng giá trị sửa chữa đã hoàn thành
                </span>
                <div class="display-6 fw-bold text-warning my-1">
                    @Model.TongGiaTriPhatSinh.ToString("#,##0.##") <span class="fs-4 text-light fw-normal">VNĐ</span>
                </div>
                <small class="text-muted" style="color: #cbd5e1 !important;">
                    Tổng chi phí thực tế của các phiếu đã hoàn thành; chưa xác nhận thanh toán.
                </small>
            </div>
            <a asp-controller="ThongKe" asp-action="Index" class="btn btn-outline-light d-flex align-items-center gap-2 px-3 py-2">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <span>Xem phân tích chi tiết</span>
            </a>
        </div>
    </div>

    <!-- HÀNG BIỂU ĐỒ -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-8">
            <div class="card card-enterprise h-100 mb-0">
                <div class="card-header">
                    <i class="bi bi-graph-up text-primary me-2"></i>
                    <span>Tăng trưởng tiếp nhận phiếu & Giá trị hoàn thành 6 tháng gần nhất</span>
                </div>
                <div class="card-body">
                    <canvas id="chartTrendDashboard" height="110"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card card-enterprise h-100 mb-0">
                <div class="card-header">
                    <i class="bi bi-pie-chart text-info me-2"></i>
                    <span>Tỷ lệ phân bố trạng thái</span>
                </div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <div style="position: relative; width: 220px; height: 220px;">
                        <canvas id="chartStatusDashboard"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH PHIẾU GẦN NHẤT -->
    <div class="card card-enterprise">
        <div class="card-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-inbox-fill text-primary"></i>
                <span class="fw-bold">Danh sách phiếu sửa chữa mới nhất</span>
            </div>
            <a asp-controller="PhieuSuaChua" asp-action="Index" class="btn btn-outline-primary btn-sm">
                Xem tất cả phiếu <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-enterprise mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Khách hàng</th>
                        <th>Thiết bị</th>
                        <th>Nội dung sự cố</th>
                        <th>Trạng thái</th>
                        <th>Mức độ</th>
                        <th>Ngày tiếp nhận</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PhieuMoiNhat != null && Model.PhieuMoiNhat.Any())
                    {
                        @foreach (var p in Model.PhieuMoiNhat)
                        {
                            <tr>
                                <td><span class="fw-bold font-monospace">#@p.MaPhieu</span></td>
                                <td>@(p.KhachHang?.HoTen ?? "Khách vãng lai")</td>
                                <td>@(p.ThietBi?.TenThietBi ?? "Thiết bị #" + p.MaThietBi)</td>
                                <td>
                                    <span class="text-truncate d-inline-block text-secondary" style="max-width: 280px;" title="@p.NoiDungLoi">
                                        @p.NoiDungLoi
                                    </span>
                                </td>
                                <td>
                                    <partial name="_TrangThaiPhieu" model="p.TrangThai" />
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">@p.MucDo</span>
                                </td>
                                <td>@p.NgayTiepNhan.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <a asp-controller="PhieuSuaChua" asp-action="Details" asp-route-id="@p.MaPhieu" class="btn-action btn-action-view" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctxTrend = document.getElementById('chartTrendDashboard');
            if (ctxTrend) {
                const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ThangLabels));
                const dataPhieu = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SoPhieuTheoThangData));
                const dataDoanhThu = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThuTheoThangData));

                new Chart(ctxTrend, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Số phiếu tiếp nhận',
                                data: dataPhieu,
                                backgroundColor: 'rgba(59, 130, 246, 0.75)',
                                borderColor: '#2563eb',
                                borderWidth: 1,
                                borderRadius: 6,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Giá trị hoàn thành (VNĐ)',
                                data: dataDoanhThu,
                                type: 'line',
                                borderColor: '#f59e0b',
                                backgroundColor: 'rgba(245, 158, 11, 0.1)',
                                fill: true,
                                tension: 0.35,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: { display: true, text: 'Số phiếu' }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                grid: { drawOnChartArea: false },
                                title: { display: true, text: 'Giá trị hoàn thành (VNĐ)' },
                                ticks: {
                                    callback: function(value) {
                                        return (value / 1000000) + ' Tr';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            const ctxStatus = document.getElementById('chartStatusDashboard');
            if (ctxStatus) {
                new Chart(ctxStatus, {
                    type: 'doughnut',
                    data: {
                        labels: ['Chờ tiếp nhận', 'Đang xử lý', 'Hoàn thành', 'Đã hủy', 'Từ chối tiếp nhận'],
                        datasets: [{
                            data: [
                                @Model.SoGiaoDichChoXuLy,
                                @Model.SoGiaoDichDangXuLy,
                                @Model.SoGiaoDichHoanThanh,
                                @Model.SoGiaoDichDaHuy,
                                @Model.SoGiaoDichTuChoi
                            ],
                            backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#ef4444', '#64748b'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } },
                        cutout: '65%'
                    }
                });
            }
        });
    </script>
}
