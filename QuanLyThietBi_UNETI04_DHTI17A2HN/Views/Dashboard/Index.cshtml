
@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.ViewModel.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Tổng Quan";

    var tongPhieu = Model.TongSoGiaoDich > 0 ? Model.TongSoGiaoDich : 1;
    var pctChoXuLy = (Model.SoGiaoDichChoXuLy * 100) / tongPhieu;
    var pctDangXuLy = (Model.SoGiaoDichDangXuLy * 100) / tongPhieu;
    var pctHoanThanh = (Model.SoGiaoDichHoanThanh * 100) / tongPhieu;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --bg-grad-primary: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
        --bg-grad-success: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --bg-grad-warning: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        --bg-grad-info: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
        --bg-grad-danger: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
        --bg-grad-purple: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    }

    body {
        background-color: #f8fafc;
    }

    .dashboard-card {
        border: none;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.12);
        }

    .icon-box {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: #ffffff;
        box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.15);
    }

    .icon-primary {
        background: var(--bg-grad-primary);
    }

    .icon-success {
        background: var(--bg-grad-success);
    }

    .icon-warning {
        background: var(--bg-grad-warning);
    }

    .icon-info {
        background: var(--bg-grad-info);
    }

    .icon-danger {
        background: var(--bg-grad-danger);
    }

    .icon-purple {
        background: var(--bg-grad-purple);
    }

   
    .card-revenue {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #ffffff;
    }

        .card-revenue .text-muted-custom {
            color: #94a3b8;
        }

 
    .progress-thin {
        height: 6px;
        border-radius: 10px;
        background-color: #f1f5f9;
    }


    .page-header-title {
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #0f172a;
    }

    .live-badge {
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.2);
        padding: 6px 14px;
        border-radius: 30px;
        font-weight: 500;
    }
</style>

<div class="container-fluid py-4 px-lg-4">
   
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="page-header-title mb-1">
                <i class="bi bi-grid-1x2-fill text-primary me-2"></i>Dashboard 
            </h2>
            @* <p class="text-muted mb-0 small">Thống kê chỉ số và hiệu suất hệ thống theo thời gian thực</p> *@
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="live-badge small">
                <i class="bi bi-clock-history me-1"></i>Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </span>
            <a asp-controller="ThongKe" asp-action="Index" class="btn btn-primary rounded-pill px-3 shadow-sm">
                <i class="bi bi-bar-chart-line-fill me-1"></i> Thống kê chi tiết
            </a>
        </div>
    </div>


    <div class="row g-4 mb-4">
       
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card dashboard-card p-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-1">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase mb-1">Loại thiết bị</div>
                        <div class="fs-2 fw-bold text-dark">@Model.TongSoLoaiThietBi</div>
                    </div>
                    <div class="icon-box icon-purple">
                        <i class="bi bi-tags-fill"></i>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card dashboard-card p-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-1">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase mb-1">Tổng thiết bị</div>
                        <div class="fs-2 fw-bold text-dark">@Model.TongSoThietBi</div>
                    </div>
                    <div class="icon-box icon-primary">
                        <i class="bi bi-laptop"></i>
                    </div>
                </div>
            </div>
        </div>

 
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card dashboard-card p-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-1">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase mb-1">Thiết bị khả dụng</div>
                        <div class="fs-2 fw-bold text-success">@Model.SoThietBiKhaDung</div>
                    </div>
                    <div class="icon-box icon-success">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card dashboard-card p-3 h-100">
                <div class="card-body d-flex align-items-center justify-content-between p-1">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase mb-1">Khách hàng</div>
                        <div class="fs-2 fw-bold text-info">@Model.TongSoKhachHang</div>
                    </div>
                    <div class="icon-box icon-info">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="row g-4">
 
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card dashboard-card p-3 h-100">
                <div class="card-body p-1">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Tổng phiếu SC</span>
                        <div class="icon-box icon-primary" style="width:42px; height:42px; font-size:1.2rem;">
                            <i class="bi bi-tools"></i>
                        </div>
                    </div>
                    <div class="fs-2 fw-bold text-dark mb-1">@Model.TongSoGiaoDich</div>
                    <div class="text-muted small"><i class="bi bi-activity me-1"></i>Toàn bộ lịch sử</div>
                </div>
            </div>
        </div>


        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card dashboard-card p-3 h-100">
                <div class="card-body p-1">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Chờ tiếp nhận</span>
                        <div class="icon-box icon-warning" style="width:42px; height:42px; font-size:1.2rem;">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                    <div class="fs-2 fw-bold text-warning mb-2">@Model.SoGiaoDichChoXuLy</div>
                    <div class="progress progress-thin">
                        <div class="progress-bar bg-warning" style="width: @pctChoXuLy%"></div>
                    </div>
                </div>
            </div>
        </div>

  
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card dashboard-card p-3 h-100">
                <div class="card-body p-1">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Đang xử lý</span>
                        <div class="icon-box icon-primary" style="width:42px; height:42px; font-size:1.2rem;">
                            <i class="bi bi-gear-wide-connected"></i>
                        </div>
                    </div>
                    <div class="fs-2 fw-bold text-primary mb-2">@Model.SoGiaoDichDangXuLy</div>
                    <div class="progress progress-thin">
                        <div class="progress-bar bg-primary" style="width: @pctDangXuLy%"></div>
                    </div>
                </div>
            </div>
        </div>

        
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card dashboard-card p-3 h-100">
                <div class="card-body p-1">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">Hoàn thành</span>
                        <div class="icon-box icon-success" style="width:42px; height:42px; font-size:1.2rem;">
                            <i class="bi bi-check2-all"></i>
                        </div>
                    </div>
                    <div class="fs-2 fw-bold text-success mb-2">@Model.SoGiaoDichHoanThanh</div>
                    <div class="progress progress-thin">
                        <div class="progress-bar bg-success" style="width: @pctHoanThanh%"></div>
                    </div>
                </div>
            </div>
        </div>

   
        <div class="col-12">
            <div class="card dashboard-card card-revenue p-4">
                <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 p-0">
                    <div>
                        <div class="text-muted-custom small fw-semibold text-uppercase mb-1">
                            <i class="bi bi-cash-stack me-1"></i> Doanh thu 
                        </div>
                        <div class="display-6 fw-bold text-warning">
                            @Model.TongGiaTriPhatSinh.ToString("N0") <span class="fs-4 text-light">VNĐ</span>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill fs-6 shadow-sm">
                            <i class="bi bi-graph-up-arrow text-success me-1"></i> Doanh thu thực tế
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>