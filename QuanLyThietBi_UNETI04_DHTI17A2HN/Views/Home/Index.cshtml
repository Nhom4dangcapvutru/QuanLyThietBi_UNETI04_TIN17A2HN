@model QuanLyThietBi_UNETI04_DHTI17A2HN.ViewModels.DashboardViewModel
@using QuanLyThietBi_UNETI04_DHTI17A2HN.Helpers
@{
    bool isKhachHang = SessionHelper.IsKhachHang(Context.Session);
    ViewData["Title"] = isKhachHang ? "Cổng Dịch vụ Khách hàng" : "Dashboard Trung tâm Sửa chữa";
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
    
    var tongPhieu = Model.TongSoGiaoDich > 0 ? Model.TongSoGiaoDich : 1;
    var pctChoXuLy = (Model.SoGiaoDichChoXuLy * 100) / tongPhieu;
    var pctDangXuLy = (Model.SoGiaoDichDangXuLy * 100) / tongPhieu;
    var pctHoanThanh = (Model.SoGiaoDichHoanThanh * 100) / tongPhieu;
}

<div class="container-fluid px-0">
    <!-- HEADER BẢNG ĐIỀU HÀNH -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                @if (isKhachHang)
                {
                    <h3 class="fw-bold mb-0 text-dark">Cổng Dịch vụ Khách hàng</h3>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                        <i class="bi bi-person-check me-1"></i>Khách hàng: @hoTen
                    </span>
                }
                else
                {
                    <h3 class="fw-bold mb-0 text-dark">Trung tâm Điều hành & Quản lý Sửa chữa</h3>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <i class="bi bi-broadcast me-1"></i>Trực quan thời gian thực
                    </span>
                }
            </div>
            <p class="text-muted small mb-0">
                @(isKhachHang 
                    ? "Theo dõi tình trạng thiết bị cá nhân, đăng ký sửa chữa bảo hành và tiến độ xử lý kỹ thuật" 
                    : "Hệ thống theo dõi quy trình bảo hành, tiếp nhận thiết bị và tiến độ xử lý kỹ thuật UNETI")
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-controller="PhieuSuaChua" asp-action="Create" class="btn btn-primary btn-sm d-flex align-items-center gap-2 shadow-sm px-3 py-2">
                <i class="bi bi-plus-circle-fill"></i>
                <span class="fw-semibold">@(isKhachHang ? "Tạo phiếu sửa chữa" : "Tiếp nhận phiếu mới")</span>
            </a>
            @if (isKhachHang)
            {
                <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 px-3 py-2">
                    <i class="bi bi-person-badge"></i>
                    <span>Hồ sơ của tôi</span>
                </a>
            }
            else
            {
                <a asp-controller="ThongKe" asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 px-3 py-2">
                    <i class="bi bi-bar-chart-line-fill"></i>
                    <span>Thống kê chi tiết</span>
                </a>
            }
        </div>
    </div>

    <!-- HÀNG THẺ KPI METRICS (4 CỘT) -->
    <div class="row g-3 mb-4">
        <!-- KPI 1: Thiết bị -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-enterprise h-100 p-3 mb-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">@(isKhachHang ? "Thiết bị của tôi" : "Tổng thiết bị")</span>
                        <h2 class="fw-bold text-dark my-1">@Model.TongSoThietBi</h2>
                        <span class="text-muted small">
                            <i class="bi bi-check-circle-fill text-success me-1"></i>@Model.SoThietBiKhaDung hoạt động
                        </span>
                    </div>
                    <div class="feature-icon" style="width: 48px; height: 48px; border-radius: 12px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                        <i class="bi bi-laptop"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 2: Chờ tiếp nhận (Vàng) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-enterprise h-100 p-3 mb-0" style="border-left: 4px solid #f59e0b;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Chờ tiếp nhận</span>
                        <h2 class="fw-bold text-warning my-1">@Model.SoGiaoDichChoXuLy</h2>
                        <span class="text-muted small">
                            <i class="bi bi-clock-history me-1"></i>@pctChoXuLy% tổng số phiếu
                        </span>
                    </div>
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: #fef3c7; color: #d97706; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 3: Đang sửa chữa (Xanh dương) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-enterprise h-100 p-3 mb-0" style="border-left: 4px solid #3b82f6;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Đang xử lý</span>
                        <h2 class="fw-bold text-primary my-1">@Model.SoGiaoDichDangXuLy</h2>
                        <span class="text-muted small">
                            <i class="bi bi-wrench-adjustable me-1"></i>@(isKhachHang ? "Đang được xử lý" : "KTV đang thao tác")
                        </span>
                    </div>
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                        <i class="bi bi-gear-wide-connected"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 4: Hoàn thành (Xanh lá) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card card-enterprise h-100 p-3 mb-0" style="border-left: 4px solid #10b981;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Đã hoàn thành</span>
                        <h2 class="fw-bold text-success my-1">@Model.SoGiaoDichHoanThanh</h2>
                        <span class="text-muted small">
                            <i class="bi bi-check2-all me-1"></i>Sẵn sàng nhận máy
                        </span>
                    </div>
                    <div style="width: 48px; height: 48px; border-radius: 12px; background: #dcfce7; color: #15803d; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BANNER TỔNG HỢP CHI PHÍ / DOANH THU -->
    <div class="card card-enterprise p-4 mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; border: none;">
        <div class="row align-items-center g-3">
            <div class="col-md-7">
                <span class="text-uppercase small fw-bold" style="color: #94a3b8; letter-spacing: 0.05em;">
                    <i class="bi bi-cash-stack me-1"></i>
                    @(isKhachHang ? "Tổng chi phí sửa chữa của bạn" : "Tổng giá trị sửa chữa đã hoàn thành")
                </span>
                <div class="display-6 fw-bold text-warning my-1">
                    @Model.TongGiaTriPhatSinh.ToString("#,##0.##") <span class="fs-4 text-light fw-normal">VNĐ</span>
                </div>
                <div class="small text-muted" style="color: #cbd5e1 !important;">
                    @(isKhachHang 
                        ? "Tổng chi phí thực tế của các phiếu đã hoàn thành của bạn; chưa xác nhận thanh toán."
                        : "Tổng chi phí thực tế của các phiếu đã hoàn thành; chưa xác nhận thanh toán.")
                </div>
            </div>
            <div class="col-md-5 d-flex flex-wrap justify-content-md-end gap-2">
                @if (isKhachHang)
                {
                    <div class="bg-dark bg-opacity-50 p-3 rounded-3 text-center border border-secondary" style="min-width: 120px;">
                        <span class="d-block small text-muted">Phiếu của tôi</span>
                        <strong class="fs-5 text-white">@Model.TongSoGiaoDich</strong>
                    </div>
                    <div class="bg-dark bg-opacity-50 p-3 rounded-3 text-center border border-secondary" style="min-width: 120px;">
                        <span class="d-block small text-muted">Đang xử lý</span>
                        <strong class="fs-5 text-warning">@Model.SoGiaoDichDangXuLy</strong>
                    </div>
                    <div class="bg-dark bg-opacity-50 p-3 rounded-3 text-center border border-secondary" style="min-width: 120px;">
                        <span class="d-block small text-muted">Đã xong</span>
                        <strong class="fs-5 text-success">@Model.SoGiaoDichHoanThanh</strong>
                    </div>
                }
                else
                {
                    <div class="bg-dark bg-opacity-50 p-3 rounded-3 text-center border border-secondary" style="min-width: 120px;">
                        <span class="d-block small text-muted">Tổng số phiếu</span>
                        <strong class="fs-5 text-white">@Model.TongSoGiaoDich</strong>
                    </div>
                    <div class="bg-dark bg-opacity-50 p-3 rounded-3 text-center border border-secondary" style="min-width: 120px;">
                        <span class="d-block small text-muted">Khách hàng</span>
                        <strong class="fs-5 text-info">@Model.TongSoKhachHang</strong>
                    </div>
                    <div class="bg-dark bg-opacity-50 p-3 rounded-3 text-center border border-secondary" style="min-width: 120px;">
                        <span class="d-block small text-muted">Loại thiết bị</span>
                        <strong class="fs-5 text-primary">@Model.TongSoLoaiThietBi</strong>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- HÀNG BIỂU ĐỒ THỐNG KÊ (CHART.JS) -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ cột: Xu hướng -->
        <div class="col-12 col-lg-8">
            <div class="card card-enterprise h-100 mb-0">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div>
                        <i class="bi bi-graph-up text-primary me-2"></i>
                        <span>@(isKhachHang ? "Lịch sử tiếp nhận phiếu 6 tháng gần nhất của bạn" : "Xu hướng tiếp nhận phiếu & Giá trị hoàn thành 6 tháng gần nhất")</span>
                    </div>
                    <span class="badge bg-light text-secondary border">Chart.js</span>
                </div>
                <div class="card-body">
                    <canvas id="chartTrend" height="110"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ Doughnut: Tỷ lệ trạng thái phiếu -->
        <div class="col-12 col-lg-4">
            <div class="card card-enterprise h-100 mb-0">
                <div class="card-header">
                    <i class="bi bi-pie-chart text-info me-2"></i>
                    <span>@(isKhachHang ? "Tỷ lệ trạng thái phiếu của bạn" : "Cơ cấu trạng thái phiếu")</span>
                </div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <div style="position: relative; width: 220px; height: 220px;">
                        <canvas id="chartStatus"></canvas>
                    </div>
                    <div class="d-flex flex-wrap justify-content-center gap-3 mt-3 small">
                        <span class="d-flex align-items-center gap-1">
                            <span style="width: 10px; height: 10px; background: #f59e0b; border-radius: 50%;"></span> Chờ tiếp nhận
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <span style="width: 10px; height: 10px; background: #3b82f6; border-radius: 50%;"></span> Đang xử lý
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <span style="width: 10px; height: 10px; background: #10b981; border-radius: 50%;"></span> Hoàn thành
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <span style="width: 10px; height: 10px; background: #ef4444; border-radius: 50%;"></span> Đã hủy
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH PHIẾU MỚI NHẤT (RECENT TICKETS TABLE) -->
    <div class="card card-enterprise mb-4">
        <div class="card-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-inbox-fill text-primary"></i>
                <span class="fw-bold">@(isKhachHang ? "Phiếu sửa chữa gần đây của bạn" : "Phiếu sửa chữa mới tiếp nhận gần đây")</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Mới nhất</span>
            </div>
            <a asp-controller="PhieuSuaChua" asp-action="Index" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                <span>@(isKhachHang ? "Xem tất cả phiếu của tôi" : "Xem tất cả phiếu")</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-enterprise mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 90px;">Mã phiếu</th>
                        @if (!isKhachHang)
                        {
                            <th>Khách hàng</th>
                        }
                        <th>Thiết bị & Serial</th>
                        <th>Nội dung sự cố</th>
                        <th>Trạng thái</th>
                        <th>Mức độ</th>
                        <th>Ngày tiếp nhận</th>
                        <th class="text-center" style="width: 80px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PhieuMoiNhat != null && Model.PhieuMoiNhat.Any())
                    {
                        @foreach (var p in Model.PhieuMoiNhat)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark font-monospace">#@p.MaPhieu</span>
                                </td>
                                @if (!isKhachHang)
                                {
                                    <td>
                                        <div class="fw-semibold text-dark">@(p.KhachHang?.HoTen ?? "Khách vãng lai")</div>
                                        <small class="text-muted">@(p.KhachHang?.SoDienThoai ?? "—")</small>
                                    </td>
                                }
                                <td>
                                    <div class="fw-medium text-dark">@(p.ThietBi?.TenThietBi ?? "Thiết bị #" + p.MaThietBi)</div>
                                    <small class="text-muted font-monospace">S/N: @(p.ThietBi?.SerialNumber ?? "—")</small>
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block text-secondary" style="max-width: 260px;" title="@p.NoiDungLoi">
                                        @p.NoiDungLoi
                                    </span>
                                </td>
                                <td>
                                    @if (p.TrangThai == "Chờ tiếp nhận")
                                    {
                                        <span class="badge-status-tiepnhan">
                                            <i class="bi bi-hourglass-split"></i> Tiếp nhận
                                        </span>
                                    }
                                    else if (p.TrangThai == "Đang xử lý")
                                    {
                                        <span class="badge-status-dangsua">
                                            <i class="bi bi-gear-wide-connected"></i> Đang sửa
                                        </span>
                                    }
                                    else if (p.TrangThai == "Hoàn thành")
                                    {
                                        <span class="badge-status-hoanthanh">
                                            <i class="bi bi-check-circle-fill"></i> Hoàn thành
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-dahuy">
                                            <i class="bi bi-x-circle-fill"></i> @p.TrangThai
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (p.MucDo == "Khẩn cấp")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Khẩn cấp</span>
                                    }
                                    else if (p.MucDo == "Cao")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Cao</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border">@p.MucDo</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-secondary small">
                                        @p.NgayTiepNhan.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-action-group justify-content-center">
                                        <a asp-controller="PhieuSuaChua" asp-action="Details" asp-route-id="@p.MaPhieu" class="btn-action btn-action-view" title="Xem chi tiết phiếu">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(isKhachHang ? 7 : 8)" class="text-center py-4 text-muted">
                                @(isKhachHang ? "Bạn chưa có phiếu sửa chữa nào trong hệ thống." : "Chưa có phiếu sửa chữa nào trong hệ thống.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Chart.js Script -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Biểu đồ xu hướng xử lý phiếu & Doanh thu
            const ctxTrend = document.getElementById('chartTrend');
            if (ctxTrend) {
                const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ThangLabels));
                const dataPhieu = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SoPhieuTheoThangData));
                const dataDoanhThu = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoanhThuTheoThangData));
                const isCustomer = @(isKhachHang ? "true" : "false");

                const datasets = [
                    {
                        label: isCustomer ? 'Phiếu sửa chữa của bạn' : 'Số phiếu tiếp nhận',
                        data: dataPhieu,
                        backgroundColor: 'rgba(59, 130, 246, 0.75)',
                        borderColor: '#2563eb',
                        borderWidth: 1,
                        borderRadius: 6,
                        yAxisID: 'y'
                    }
                ];

                if (!isCustomer) {
                    datasets.push({
                        label: 'Giá trị hoàn thành (VNĐ)',
                        data: dataDoanhThu,
                        type: 'line',
                        borderColor: '#f59e0b',
                        backgroundColor: 'rgba(245, 158, 11, 0.15)',
                        fill: true,
                        tension: 0.35,
                        yAxisID: 'y1'
                    });
                }

                new Chart(ctxTrend, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: datasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        scales: {
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                title: { display: true, text: 'Số lượng phiếu' },
                                ticks: { stepSize: 1, precision: 0 }
                            },
                            y1: {
                                type: 'linear',
                                display: !isCustomer,
                                position: 'right',
                                grid: { drawOnChartArea: false },
                                title: { display: true, text: 'Giá trị hoàn thành (VNĐ)' },
                                ticks: {
                                    callback: function(value) {
                                        return (value / 1000000) + ' Tr';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // 2. Biểu đồ tròn (Doughnut): Cơ cấu trạng thái phiếu
            const ctxStatus = document.getElementById('chartStatus');
            if (ctxStatus) {
                new Chart(ctxStatus, {
                    type: 'doughnut',
                    data: {
                        labels: ['Chờ tiếp nhận', 'Đang xử lý', 'Hoàn thành', 'Đã hủy'],
                        datasets: [{
                            data: [
                                @Model.SoGiaoDichChoXuLy,
                                @Model.SoGiaoDichDangXuLy,
                                @Model.SoGiaoDichHoanThanh,
                                @Model.SoGiaoDichDaHuy
                            ],
                            backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#ef4444'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        cutout: '70%'
                    }
                });
            }
        });
    </script>
}
