
@model QuanLyThietBi_UNETI04_DHTI17A2HN.Models.ViewModel.ThongKeViewModel
@{
    ViewData["Title"] = "Thống Kê Chi Tiết";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --primary-grad: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
        --success-grad: linear-gradient(135deg, #10b981 0%, #059669 100%);
        --warning-grad: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        --info-grad: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
        --purple-grad: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
    }

    body {
        background-color: #f8fafc;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }


    .kpi-card {
        border: none;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);
        transition: all 0.3s ease;
    }

        .kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.08);
        }

    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        color: white;
    }


    .stat-card {
        border: none;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

        .stat-card .card-header {
            background: #ffffff;
            border-bottom: 1px solid #f1f5f9;
            padding: 1.2rem 1.5rem;
            font-weight: 700;
            color: #0f172a;
        }

    .chart-container {
        position: relative;
        height: 240px;
        width: 100%;
    }

    /* Top Rank Badges */
    .rank-badge {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.8rem;
    }

    .rank-1 {
        background-color: #fef3c7;
        color: #d97706;
    }

    .rank-2 {
        background-color: #e2e8f0;
        color: #475569;
    }

    .rank-3 {
        background-color: #ffedd5;
        color: #c2410c;
    }
</style>

<div class="container-fluid py-4 px-lg-4">
   
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Thống Kê Chi Tiết
            @* </h2>
            <p class="text-muted small mb-0">Báo cáo phân tích chuyên sâu dữ liệu thiết bị & hoạt động sửa chữa (LINQ Queries)</p> *@
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> In báo cáo
            </button>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Về Dashboard
            </a>
        </div>
    </div>


    <div class="row g-3 mb-4">
      
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card kpi-card p-3 h-100 border-start border-4 border-primary">
                <div class="card-body p-1 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase mb-1">Thới gian SC trung bình</div>
                        <div class="fs-3 fw-bold text-primary">
                            @Model.ThoiGianSuaChuaTrungBinh.ToString("0.0")
                            <span class="fs-6 text-muted fw-normal">ngày</span>
                        </div>
                    </div>
                    <div class="icon-box" style="background: var(--primary-grad);">
                        <i class="bi bi-hourglass-bottom"></i>
                    </div>
                </div>
            </div>
        </div>

     
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card kpi-card p-3 h-100 border-start border-4 border-warning">
                <div class="card-body p-1 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase mb-1">Chi phí linh kiện</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TongChiPhiLinhKien.ToString("N0") <span class="fs-6 text-muted">VNĐ</span></div>
                    </div>
                    <div class="icon-box" style="background: var(--warning-grad);">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                </div>
            </div>
        </div>

      
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card kpi-card p-3 h-100 border-start border-4 border-success">
                <div class="card-body p-1 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase mb-1">Doanh thu sửa chữa</div>
                        <div class="fs-4 fw-bold text-success">@Model.DoanhThuSuaChua.ToString("N0") <span class="fs-6 text-muted">VNĐ</span></div>
                    </div>
                    <div class="icon-box" style="background: var(--success-grad);">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>
            </div>
        </div>

   
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card kpi-card p-3 h-100 border-start border-4 border-info">
                <div class="card-body p-1">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Tỷ lệ trong bảo hành</span>
                        <span class="fs-5 fw-bold text-info">@Model.TyLeSuaChuaTrongBaoHanh %</span>
                    </div>
                    <div class="progress mb-2" style="height: 6px;">
                        <div class="progress-bar bg-info" style="width: @Model.TyLeSuaChuaTrongBaoHanh%"></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center small">
                        <span class="badge bg-success-subtle text-success">Trong BH: @Model.SoPhieuTrongBaoHanh</span>
                        <span class="badge bg-secondary-subtle text-secondary">Ngoài BH: @Model.SoPhieuNgoaiBaoHanh</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

  
    <div class="row g-4">
       
        <div class="col-12 col-lg-6">
            <div class="card stat-card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-laptop me-2 text-primary"></i>1. Số thiết bị theo loại</span>
                    <span class="badge bg-primary-subtle text-primary">Biểu đồ Cột</span>
                </div>
                <div class="card-body">
                    <div class="chart-container mb-3">
                        <canvas id="chartLoaiThietBi"></canvas>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Loại thiết bị</th>
                                    <th>Hãng sản xuất</th>
                                    <th class="text-end">Số lượng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SoThietBiTheoLoai)
                                {
                                    <tr>
                                        <td class="fw-medium">@item.TenLoai</td>
                                        <td><span class="badge bg-light text-dark border">@item.HangSanXuat</span></td>
                                        <td class="text-end fw-bold text-primary">@item.SoLuong</td>
                                    </tr>
                                }
                                @if (!Model.SoThietBiTheoLoai.Any())
                                {
                                    <tr><td colspan="3" class="text-center text-muted py-3">Chưa có dữ liệu</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card stat-card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-pie-chart-fill me-2 text-warning"></i>2. Số phiếu theo trạng thái</span>
                    <span class="badge bg-warning-subtle text-warning">Biểu đồ Tròn</span>
                </div>
                <div class="card-body">
                    <div class="chart-container mb-3">
                        <canvas id="chartTrangThai"></canvas>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Số phiếu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SoPhieuTheoTrangThai)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-circle-fill me-2 small text-primary"></i>@item.TrangThai
                                        </td>
                                        <td class="text-end fw-bold">@item.SoLuong</td>
                                    </tr>
                                }
                                @if (!Model.SoPhieuTheoTrangThai.Any())
                                {
                                    <tr><td colspan="2" class="text-center text-muted py-3">Chưa có dữ liệu</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    
        <div class="col-12 col-lg-6">
            <div class="card stat-card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-graph-up-arrow me-2 text-success"></i>3. Số phiếu theo tháng (12 tháng gần nhất)</span>
                    <span class="badge bg-success-subtle text-success">Biểu đồ Xu hướng</span>
                </div>
                <div class="card-body">
                    <div class="chart-container mb-3">
                        <canvas id="chartTheoThang"></canvas>
                    </div>
                    <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Tháng/Năm</th>
                                    <th class="text-end">Số phiếu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SoPhieuTheoThang)
                                {
                                    <tr>
                                        <td>@item.Label</td>
                                        <td class="text-end fw-bold text-success">@item.SoLuong</td>
                                    </tr>
                                }
                                @if (!Model.SoPhieuTheoThang.Any())
                                {
                                    <tr><td colspan="2" class="text-center text-muted py-3">Chưa có dữ liệu</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

     
        <div class="col-12 col-lg-6">
            <div class="card stat-card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-trophy-fill me-2 text-danger"></i>4. Top kỹ thuật viên xuất sắc</span>
                    <span class="badge bg-danger-subtle text-danger">Xếp hạng KTV</span>
                </div>
                <div class="card-body">
                    <div class="chart-container mb-3">
                        <canvas id="chartTopKTV"></canvas>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Họ tên KTV</th>
                                    <th class="text-end">Số phiếu xử lý</th>
                                    <th class="text-end">Chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int stt = 1;
                                }
                                @foreach (var item in Model.TopKyThuatVien)
                                {
                                    <tr>
                                        <td>
                                            <span class="rank-badge @(stt == 1 ? "rank-1" : stt == 2 ? "rank-2" : stt == 3 ? "rank-3" : "bg-light text-dark")">
                                                @stt
                                            </span>
                                        </td>
                                        <td class="fw-semibold text-dark">
                                            <i class="bi bi-person-circle me-1 text-secondary"></i>@item.HoTen
                                        </td>
                                        <td class="text-end fw-bold text-danger">@item.SoPhieuXuLy</td>
                                        <td class="text-end text-muted small">@item.SoChiTiet</td>
                                    </tr>
                                    stt++;
                                }
                                @if (!Model.TopKyThuatVien.Any())
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-3">Chưa có dữ liệu</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
       
        Chart.defaults.font.family = "'Inter', system-ui, sans-serif";
        Chart.defaults.color = '#64748b';

    
        const dataLoai = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SoThietBiTheoLoai.Select(x => new { x.TenLoai, x.SoLuong })));
        new Chart(document.getElementById('chartLoaiThietBi'), {
            type: 'bar',
            data: {
                labels: dataLoai.map(x => x.TenLoai),
                datasets: [{
                    label: 'Số lượng thiết bị',
                    data: dataLoai.map(x => x.SoLuong),
                    backgroundColor: '#3b82f6',
                    borderRadius: 8
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });

    
        const dataTrangThai = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SoPhieuTheoTrangThai.Select(x => new { x.TrangThai, x.SoLuong })));
        new Chart(document.getElementById('chartTrangThai'), {
            type: 'doughnut',
            data: {
                labels: dataTrangThai.map(x => x.TrangThai),
                datasets: [{
                    data: dataTrangThai.map(x => x.SoLuong),
                    backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#ef4444', '#8b5cf6'],
                    borderWidth: 2
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } }
        });

       
        const dataThang = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SoPhieuTheoThang.Select(x => new { x.Label, x.SoLuong })));
        new Chart(document.getElementById('chartTheoThang'), {
            type: 'line',
            data: {
                labels: dataThang.map(x => x.Label),
                datasets: [{
                    label: 'Số phiếu',
                    data: dataThang.map(x => x.SoLuong),
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.35,
                    pointRadius: 4
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });

        const dataKTV = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopKyThuatVien.Select(x => new { x.HoTen, x.SoPhieuXuLy })));
        new Chart(document.getElementById('chartTopKTV'), {
            type: 'bar',
            data: {
                labels: dataKTV.map(x => x.HoTen),
                datasets: [{
                    label: 'Số phiếu xử lý',
                    data: dataKTV.map(x => x.SoPhieuXuLy),
                    backgroundColor: '#f43f5e',
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });
    });
</script>