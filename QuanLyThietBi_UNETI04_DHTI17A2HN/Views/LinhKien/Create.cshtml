@model QuanLyThietBi_UNETI04_DHTI17A2HN.ViewModels.LinhKienCreateViewModel
@{ ViewData["Title"] = "Thêm linh kiện"; }
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><h3>Thêm linh kiện mới</h3><a asp-action="Index" class="btn btn-outline-secondary">Về kho linh kiện</a></div>
<div class="row"><div class="col-lg-8"><form asp-action="Create" method="post" class="card card-enterprise p-3 p-md-4">
<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
<partial name="_Fields" model="Model" />
<div class="mt-3"><label asp-for="SoLuongBanDau" class="form-label"></label><input asp-for="SoLuongBanDau" type="number" min="0" max="2147483647" step="1" class="form-control" /><span asp-validation-for="SoLuongBanDau" class="text-danger small"></span></div>
<div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" class="btn btn-primary">Thêm linh kiện</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a></div>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
